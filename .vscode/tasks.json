{
  "version": "2.0.0",
  // 说明：本机执行策略已修为 CurrentUser=RemoteSigned，.ps1 包装脚本可以运行。
  // 这里仍统一使用 .cmd 入口：它在 cmd / PowerShell / Git Bash 下行为一致，
  // 不依赖执行策略，也不会被以后策略被重置影响。
  "tasks": [
    {
      "label": "DSH: 启动 Web GUI",
      "type": "shell",
      "command": "dsh.cmd",
      "args": ["web"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "DSH: 在本目录开一个会话",
      "type": "shell",
      "command": "dsh.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Git: 查看当前状态",
      "type": "shell",
      "command": "git",
      "args": ["status", "--short", "--branch"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Git: 暂存全部改动并提交",
      "type": "shell",
      "command": "git",
      "args": ["commit", "-a", "-m", "${input:commitMessage}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Git: 拉取（--ff-only）",
      "type": "shell",
      "command": "git",
      "args": ["pull", "--ff-only"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Git: 推送",
      "type": "shell",
      "command": "git",
      "args": ["push"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "提交信息",
      "default": "chore: update"
    }
  ]
}
