// bench_main.asc — 本地性能/正确性评测 harness（非交付件，仅 bench/ 用）
// 与判题同契约：#include kernel.asc，按 run_kernel ABI 调用 + aclrtSynchronizeStreamWithTimeout(3000)。
// 用法: ./bench_main [cases_dir] [repeats]
// 输出 CSV: case,B,M,N,K,dtype,tx1,tx2,min_ms,med_ms,pass,maxdiff,deterministic
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <chrono>
#include <string>
#include <vector>
#include <fstream>
#include <algorithm>
#include <dirent.h>
#include <sys/stat.h>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#ifdef BENCH_SWEEP
#include "kernel_sweep.asc"
#else
#include "../kernel.asc"
#endif

static std::vector<uint8_t> readBin(const std::string &path) {
    std::ifstream f(path, std::ios::binary);
    if (!f) return {};
    f.seekg(0, std::ios::end);
    size_t n = f.tellg();
    f.seekg(0);
    std::vector<uint8_t> buf(n);
    f.read((char*)buf.data(), n);
    return buf;
}

static bool isClose(float a, float b, float rtol, float atol) {
    return std::fabs(a - b) <= atol + rtol * std::fabs(b);
}

int main(int argc, char** argv) {
    std::string dir = argc > 1 ? argv[1] : "./cases";
    int repeats = argc > 2 ? atoi(argv[2]) : 3;

    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;
    if (aclInit(nullptr) != 0) { fprintf(stderr, "aclInit fail\n"); return 1; }
    if (aclrtSetDevice(deviceId) != 0) { fprintf(stderr, "SetDevice fail\n"); return 1; }
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum);
    const char* soc = aclrtGetSocName();
    int64_t vecNum = 0;
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &vecNum);
    printf("# soc=%s cube=%ld vec=%ld\n", soc ? soc : "?", (long)availableCoreNum, (long)vecNum);
    if (aclrtCreateStream(&stream) != 0) { fprintf(stderr, "CreateStream fail\n"); return 1; }
    printf("case,B,M,N,K,dtype,tx1,tx2,min_ms,med_ms,pass,maxdiff,deterministic\n");
    fflush(stdout);

    for (int cid = 0; cid < 100; ++cid) {
        char cd[512]; snprintf(cd, sizeof(cd), "%s/case%02d", dir.c_str(), cid);
        struct stat st; if (stat(cd, &st) != 0) continue;

        char mp[600]; snprintf(mp, sizeof(mp), "%s/meta.txt", cd);
        FILE* mf = fopen(mp, "r"); if (!mf) continue;
        int64_t B,M,N,K; int dtype,tx1,tx2;
        if (fscanf(mf, "%ld %ld %ld %ld %d %d %d", &B,&M,&N,&K,&dtype,&tx1,&tx2) != 7) { fclose(mf); continue; }
        fclose(mf);

        char p1[600],p2[600],pg[600];
        snprintf(p1,sizeof(p1),"%s/x1.bin",cd); snprintf(p2,sizeof(p2),"%s/x2.bin",cd);
        snprintf(pg,sizeof(pg),"%s/golden_y.bin",cd);
        std::vector<uint8_t> hx1 = readBin(p1), hx2 = readBin(p2), hg = readBin(pg);
        if (hx1.empty()||hx2.empty()||hg.empty()) { printf("case%02d,,,,,,,,,,READ_FAIL,,,\n",cid); fflush(stdout); continue; }

        // 物理形状（按转置标志）
        int64_t x1s[3], x2s[3];
        if (tx1) { x1s[0]=B; x1s[1]=K; x1s[2]=M; } else { x1s[0]=B; x1s[1]=M; x1s[2]=K; }
        if (tx2) { x2s[0]=B; x2s[1]=N; x2s[2]=K; } else { x2s[0]=B; x2s[1]=K; x2s[2]=N; }
        int64_t ys[1] = {B};
        TensorInfo t1={x1s,3,dtype}, t2={x2s,3,dtype}, ty={ys,1,0};
        TensorGroupInfo i1={&t1,1}, i2={&t2,1}, iy={&ty,1};

        uint8_t *dx1=nullptr,*dx2=nullptr,*dy=nullptr;
        aclrtMalloc((void**)&dx1, hx1.size(), ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&dx2, hx2.size(), ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&dy, B*4, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(dx1, hx1.size(), hx1.data(), hx1.size(), ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dx2, hx2.size(), hx2.data(), hx2.size(), ACL_MEMCPY_HOST_TO_DEVICE);
        // [diagnostic] force the input copies to land before the first launch
        if (aclrtSynchronizeStream(stream) != 0) { fprintf(stderr, "sync-after-copy fail\n"); }
        if (aclrtSynchronizeDevice() != 0) { fprintf(stderr, "sync-device fail\n"); }

        std::vector<float> times; std::vector<uint8_t> y1(B*4), y2(B*4);
        bool deterministic = true;
        for (int it = 0; it < repeats; ++it) {
            aclrtMemset(dy, B*4, 0, B*4);
            auto t0 = std::chrono::steady_clock::now();
            run_kernel((GM_ADDR)dx1, i1, (GM_ADDR)dx2, i2, (GM_ADDR)dy, iy,
                       availableCoreNum, stream, tx1!=0, tx2!=0);
            aclrtSynchronizeStreamWithTimeout(stream, 3000);
            auto t1c = std::chrono::steady_clock::now();
            times.push_back(std::chrono::duration<float,std::milli>(t1c-t0).count());
            if (it == 0) aclrtMemcpy(y1.data(), B*4, dy, B*4, ACL_MEMCPY_DEVICE_TO_HOST);
            if (it == 1) { aclrtMemcpy(y2.data(), B*4, dy, B*4, ACL_MEMCPY_DEVICE_TO_HOST);
                           if (memcmp(y1.data(), y2.data(), B*4) != 0) deterministic = false; }
        }

        // 比对 golden（判题同容差）
        const float* out = (const float*)y1.data();
        const float* gold = (const float*)hg.data();
        int bad = 0; float maxd = 0;
        for (int64_t i = 0; i < B; ++i) {
            float d = std::fabs(out[i]-gold[i]);
            if (d > maxd) maxd = d;
            if (!isClose(out[i], gold[i], 1e-4f, 1e-4f)) bad++;
        }
        bool pass = (double)bad / B <= 1e-4;
        if (getenv("BENCH_DUMP_Y")) {
            for (int64_t i = 0; i < B; ++i)
                printf("  y[%ld]=%.6f gold=%.6f\n", (long)i, out[i], gold[i]);
        }
        uint64_t yh = 1469598103934665603ULL;
        for (size_t k = 0; k < y1.size(); ++k) { yh ^= y1[k]; yh *= 1099511628211ULL; }
        std::sort(times.begin(), times.end());
        printf("case%02d,%ld,%ld,%ld,%ld,%d,%d,%d,%.3f,%.3f,%s,%.6f,%d,%016llx\n",
               cid,B,M,N,K,dtype,tx1,tx2,times.front(),times[times.size()/2],
               pass?"PASS":"FAIL",maxd,(int)deterministic,(unsigned long long)yh);
        fflush(stdout);
        aclrtFree(dx1); aclrtFree(dx2); aclrtFree(dy);
    }
    aclrtDestroyStream(stream); aclrtResetDevice(deviceId); aclFinalize();
    return 0;
}
