#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <algorithm>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"

namespace bmmms {

using namespace AscendC;
using CubeTiling = AscendC::tiling::TCubeTiling;

static constexpr uint32_t TILE_M = 16;
static constexpr uint32_t MAX_TILE_N = 256;
static constexpr uint32_t BASEM_MAX = 256;
static constexpr uint32_t MWIN_MAX = 16;
static constexpr uint32_t N_CHUNK = 2048;
static constexpr uint32_t MAX_NCHUNK = 64;
static constexpr uint64_t SMALL_MAC_LIMIT = 32768;

struct Shape {
    uint32_t b;
    uint32_t m;
    uint32_t n;
    uint32_t k;
};


// ============================================================================
// Device helpers
// ============================================================================

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

__aicore__ inline float AbsF32(float x)
{
    return x < 0.0f ? -x : x;
}

__aicore__ inline float Decode(half x)
{
    return static_cast<float>(x);
}

__aicore__ inline float Decode(bfloat16_t x)
{
    return AscendC::ToFloat(x);
}

__aicore__ inline void AddCompensated(
    float value,
    float &sum,
    float &correction)
{
    const float next = sum + value;

    if (AbsF32(sum) >= AbsF32(value)) {
        correction += (sum - next) + value;
    } else {
        correction += (value - next) + sum;
    }

    sum = next;
}

template <HardEvent E>
__aicore__ inline void Fence(TPipe &pipe)
{
    const event_t event =
        static_cast<event_t>(
            pipe.FetchEventID(E));

    SetFlag<E>(event);
    WaitFlag<E>(event);
}


// ============================================================================
// Small-input path
// ============================================================================

template <typename InputT>
__global__ __aicore__ void SmallKernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    Shape shape,
    bool transposeX1,
    bool transposeX2)
{
    if (GetBlockIdx() != 0) {
        return;
    }

    TPipe pipe;

    TBuf<TPosition::VECCALC> outBuf;

    pipe.InitBuffer(
        outBuf,
        64 * sizeof(float));

    LocalTensor<float> outLocal =
        outBuf.Get<float>();


    GlobalTensor<InputT> a;
    GlobalTensor<InputT> b;
    GlobalTensor<float> out;


    a.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x1),
        static_cast<uint64_t>(shape.b) *
            shape.m *
            shape.k);


    b.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x2),
        static_cast<uint64_t>(shape.b) *
            shape.n *
            shape.k);


    out.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(y),
        shape.b);


    for (uint32_t batch = 0;
         batch < shape.b;
         ++batch) {

        const uint64_t aBase =
            static_cast<uint64_t>(batch) *
            shape.m *
            shape.k;


        const uint64_t bBase =
            static_cast<uint64_t>(batch) *
            shape.n *
            shape.k;


        float total = 0.0f;
        float totalCorr = 0.0f;


        for (uint32_t row = 0;
             row < shape.m;
             ++row) {

            float best = 0.0f;


            for (uint32_t col = 0;
                 col < shape.n;
                 ++col) {

                float dot = 0.0f;
                float dotCorr = 0.0f;


                for (uint32_t kk = 0;
                     kk < shape.k;
                     ++kk) {

                    const uint64_t aOffset =
                        aBase +
                        (
                            transposeX1
                                ?
                                static_cast<uint64_t>(kk) *
                                        shape.m +
                                    row
                                :
                                static_cast<uint64_t>(row) *
                                        shape.k +
                                    kk
                        );


                    const uint64_t bOffset =
                        bBase +
                        (
                            transposeX2
                                ?
                                static_cast<uint64_t>(col) *
                                        shape.k +
                                    kk
                                :
                                static_cast<uint64_t>(kk) *
                                        shape.n +
                                    col
                        );


                    const float product =
                        Decode(
                            a.GetValue(aOffset)
                        )
                        *
                        Decode(
                            b.GetValue(bOffset)
                        );


                    AddCompensated(
                        product,
                        dot,
                        dotCorr);
                }


                const float score =
                    dot + dotCorr;


                if (col == 0 ||
                    score > best) {

                    best = score;
                }
            }


            AddCompensated(
                best,
                total,
                totalCorr);
        }


        outLocal.SetValue(
            batch,
            total + totalCorr);
    }


    Fence<HardEvent::S_MTE3>(
        pipe);


    DataCopyExtParams copyOut;

    copyOut.blockCount = 1;

    copyOut.blockLen =
        shape.b *
        sizeof(float);

    copyOut.srcStride = 0;
    copyOut.dstStride = 0;
    copyOut.rsv = 0;


    DataCopyPad(
        out,
        outLocal,
        copyOut);


    Fence<HardEvent::MTE3_S>(
        pipe);


    PipeBarrier<PIPE_ALL>();
}


// ============================================================================
// Cube Matmul + Vector MaxSim
// ============================================================================

template <
    typename InputT,
    bool TRANSPOSE_A,
    bool TRANSPOSE_B>
__global__ __aicore__ void MatmulMaxKernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR partial,
    __kfc_workspace__ GM_ADDR systemWorkspace,
    GM_ADDR cWorkspace,
    CubeTiling tiling,
    Shape shape,
    uint32_t workerCount,
    uint32_t nChunksTask,
    uint32_t wm)
{
    TPipe pipe;


    using AType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            InputT,
            TRANSPOSE_A>;


    using BType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            InputT,
            TRANSPOSE_B>;


    using CType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            float>;


    Matmul<
        AType,
        BType,
        CType> mm;


    REGIST_MATMUL_OBJ(
        &pipe,
        GetSysWorkSpacePtr(),
        mm,
        &tiling);


    TBuf<TPosition::VECCALC>
        cTileBuf;


    TBuf<TPosition::VECCALC>
        reduceWorkBuf;


    TBuf<TPosition::VECCALC>
        tileMaxBuf;


    TBuf<TPosition::VECCALC>
        bestBuf;


    /*
     * One consumed C tile is at most 128 KiB
     * (L0C bound: baseM*baseN*4 <= 32K elems);
     * rows scale with BASEM_MAX, cols with the
     * shrunk baseN.
     */
    pipe.InitBuffer(
        cTileBuf,
        32768U *
            sizeof(float));


    pipe.InitBuffer(
        reduceWorkBuf,
        MAX_TILE_N *
            sizeof(float));


    pipe.InitBuffer(
        tileMaxBuf,
        BASEM_MAX *
            sizeof(float));


    pipe.InitBuffer(
        bestBuf,
        BASEM_MAX *
            sizeof(float));


    LocalTensor<float>
        cUb =
            cTileBuf.Get<float>();


    LocalTensor<float>
        reduceWork =
            reduceWorkBuf.Get<float>();


    LocalTensor<float>
        tileMaxVec =
            tileMaxBuf.Get<float>();


    LocalTensor<float>
        bestVec =
            bestBuf.Get<float>();


    GlobalTensor<InputT> a;
    GlobalTensor<InputT> b;
    GlobalTensor<float> partialGm;


    a.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x1),

        static_cast<uint64_t>(
            shape.b) *
            shape.m *
            shape.k);


    b.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x2),

        static_cast<uint64_t>(
            shape.b) *
            shape.n *
            shape.k);


    const uint32_t rowTiles =
        (
            shape.m +
            TILE_M - 1
        ) /
        TILE_M;


    const uint32_t rowWins =
        (
            shape.m +
            wm - 1
        ) /
        wm;


    const uint32_t realChunks =
        (
            shape.n +
            N_CHUNK - 1
        ) /
        N_CHUNK;


    partialGm.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(partial),

        static_cast<uint64_t>(
            shape.b) *
            rowTiles *
            nChunksTask *
            TILE_M);


    const uint32_t worker =
        static_cast<uint32_t>(
            GetBlockIdx());


    /*
     * AIV-side GetBlockNum() reports the AI Core
     * group count, not the flattened AIV worker
     * space that GetBlockIdx() enumerates. The
     * host passes 2 * blocks explicitly so every
     * task is claimed by exactly one AIV.
     */
    const uint32_t workers =
        workerCount;


    /*
     * Per-execution-unit GM scratch tile for the
     * packed baseM x baseN ND result written by
     * GetTensorC. AIV ids already span [0, 2N);
     * AIC group ids are shifted past that range
     * so a stray AIC-side fetch can never alias
     * an AIV slot.
     */
    const uint32_t baseM =
        tiling.baseM;


    const uint32_t baseN =
        tiling.baseN;


    uint32_t cSlot =
        worker;

    if
        ASCEND_IS_AIV
    {
        cSlot = worker;
    } else {
        cSlot =
            workers +
            worker;
    }


    /*
     * IterateAll emits a uniform slot grid of
     * mBlocks x nTiles tiles, each slot
     * baseM x baseN elements; keep slack for
     * edge emits.
     */
    const uint32_t cSlotElems =
        (
            (
                wm +
                baseM -
                1U
            ) /
            baseM
        ) *
        (
            (
                N_CHUNK +
                baseN -
                1U
            ) /
            baseN
        ) *
        baseM *
        baseN;


    GlobalTensor<float> cTile;

    cTile.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(cWorkspace) +
            static_cast<uint64_t>(cSlot) *
                cSlotElems,

        cSlotElems);


    /*
     * Task space = (batch, mwin, nChunk): every
     * worker claims strided tasks, computes the
     * row maxima of its (validM x chunkN) window,
     * and writes them to partial[task]. A second
     * kernel merges partials into y. SetOrgShape
     * is a real KFC message and the org shape is
     * constant, so it is hoisted; SetSingleShape
     * and SetTensorA/B only patch the pending
     * Iterate message and cost ~nothing.
     */
    mm.SetOrgShape(
        shape.m,
        shape.n,
        shape.k);


    const uint64_t totalTasks =
        static_cast<uint64_t>(
            shape.b) *
            rowWins *
            nChunksTask;


    for (uint64_t task = worker;
         task < totalTasks;
         task += workers) {

        const uint32_t chunk =
            static_cast<uint32_t>(
                task % nChunksTask);


        const uint32_t mw =
            static_cast<uint32_t>(
                task / nChunksTask);


        const uint32_t mwin =
            mw % rowWins;


        const uint32_t batch =
            mw / rowWins;


        const uint32_t rowStart =
            mwin * wm;


        const uint32_t validM =
            MinU32(
                wm,
                shape.m -
                    rowStart);


        const uint64_t aOffset =
            static_cast<uint64_t>(
                batch) *
                shape.m *
                shape.k
            +
            (
                TRANSPOSE_A
                    ?
                    static_cast<uint64_t>(
                        rowStart)
                    :
                    static_cast<uint64_t>(
                        rowStart) *
                        shape.k
            );


        const uint32_t mBlocks =
            (
                validM +
                baseM -
                1U
            ) /
            baseM;


        /*
         * IterateAll writes the whole
         * (validM x chunkN) strip in one KFC
         * round trip: a uniform slot grid of
         * mBlocks x nTiles tiles, each slot
         * baseM x baseN elements, m-block outer /
         * n-tile inner order, rows packed at the
         * tile's own validN — probed on 910C.
         * A singleM < baseM emits a ghost tile,
         * so M-tail windows keep the per-tile
         * Iterate/GetTensorC path.
         */
        const bool stripAtOnce =
            (validM >= baseM);


        /*
         * If the true chunk count exceeds
         * nChunksTask, fold extra chunks into
         * this task serially; the partial row
         * maxima are order-insensitive.
         */
        for (uint32_t c = chunk;
             c < realChunks;
             c += nChunksTask) {

        const uint32_t nStart =
            c * N_CHUNK;


        const uint32_t chunkN =
            MinU32(
                N_CHUNK,
                shape.n -
                    nStart);


        const uint64_t bOffset =
            static_cast<uint64_t>(
                batch) *
                shape.n *
                shape.k
            +
            (
                TRANSPOSE_B
                    ?
                    static_cast<uint64_t>(
                        nStart) *
                        shape.k
                    :
                    static_cast<uint64_t>(
                        nStart)
            );


        mm.SetSingleShape(
            validM,
            chunkN,
            shape.k);


        mm.SetTensorA(
            a[aOffset],
            TRANSPOSE_A);


        mm.SetTensorB(
            b[bOffset],
            TRANSPOSE_B);


        const uint32_t nTiles =
            (
                chunkN +
                baseN -
                1U
            ) /
            baseN;


        if (stripAtOnce) {

            mm.IterateAll(
                cTile,
                0,
                true);
        }


        for (uint32_t mb = 0;
             mb < mBlocks;
             ++mb) {

        const uint32_t mbValid =
            MinU32(
                baseM,
                validM -
                    mb * baseM);


        Duplicate(
            bestVec,
            -3.402823466e38f,
            BASEM_MAX);


        for (uint32_t nb = 0;
             nb < nTiles;
             ++nb) {

            if (!stripAtOnce) {

                if (!mm.Iterate()) {
                    break;
                }

                mm.GetTensorC(
                    cTile,
                    0,
                    true);
            }


            const uint32_t validN =
                MinU32(
                    baseN,
                    chunkN -
                        nb * baseN);


            const uint32_t tileElems =
                mbValid *
                validN;


            DataCopyExtParams
                copyParams;

            copyParams.blockCount = 1;

            copyParams.blockLen =
                tileElems *
                sizeof(float);

            copyParams.srcStride = 0;
            copyParams.dstStride = 0;
            copyParams.rsv = 0;


            DataCopyPadExtParams<float>
                padParams;


            DataCopyPad(
                cUb,
                cTile[
                    stripAtOnce
                        ?
                    (
                        mb *
                            nTiles +
                        nb
                    ) *
                        baseM *
                        baseN
                        :
                    0],
                copyParams,
                padParams);


            Fence<
                HardEvent::MTE2_V>(
                    pipe);


            const uint32_t rows =
                mbValid;


            const uint32_t rowBase = 0;


            Duplicate(
                tileMaxVec,
                -3.402823466e38f,
                BASEM_MAX);


            if (validN == baseN) {

            for (uint32_t row = 0;
                 row < rows;
                 ++row) {

                ReduceMax(
                    tileMaxVec[
                        rowBase +
                        row
                    ],
                    cUb[
                        row *
                        baseN
                    ],
                    reduceWork,
                    static_cast<int32_t>(
                        validN),
                    false);
            }

            } else {

            /*
             * Tail-N tile: KFC sequential write is
             * packed at the valid width, so rows sit
             * at row * validN. Vector reads need 32B
             * alignment; use scalar loads instead.
             */
            for (uint32_t row = 0;
                 row < rows;
                 ++row) {

                float rowBest =
                    -3.402823466e38f;

                const uint32_t srcBase =
                    row * validN;

                for (uint32_t col = 0;
                     col < validN;
                     ++col) {

                    const float v =
                        cUb.GetValue(
                            srcBase + col);

                    if (v > rowBest) {
                        rowBest = v;
                    }
                }


                tileMaxVec.SetValue(
                    rowBase + row,
                    rowBest);
            }

            }


            Max(
                bestVec,
                bestVec,
                tileMaxVec,
                BASEM_MAX);
        }


        if
            ASCEND_IS_AIV
        {

            Fence<
                HardEvent::V_MTE3>(
                    pipe);


            /*
             * A baseM-row tile can cover several
             * 16-row partial slots; write each
             * group separately.
             */
            const uint64_t pMwinBase =

                static_cast<uint64_t>(
                    mwin) *
                    (
                        wm /
                        TILE_M
                    ) +
                mb *
                    (
                        baseM /
                        TILE_M
                    );


            for (uint32_t r16 = 0;
                 r16 * TILE_M < mbValid;
                 ++r16) {

            const uint64_t pOff =

                (
                    static_cast<uint64_t>(
                        batch) *
                        rowTiles +
                    pMwinBase +
                    r16
                ) *
                    nChunksTask +
                c;


            DataCopyExtParams
                copyOut;

            copyOut.blockCount = 1;

            copyOut.blockLen =
                MinU32(
                    TILE_M,
                    mbValid -
                        r16 * TILE_M) *
                sizeof(float);

            copyOut.srcStride = 0;
            copyOut.dstStride = 0;
            copyOut.rsv = 0;


            DataCopyPad(
                partialGm[
                    pOff *
                        TILE_M
                ],
                bestVec[
                    r16 *
                        TILE_M
                ],
                copyOut);
            }


            Fence<
                HardEvent::MTE3_S>(
                    pipe);
        }
        }

        }
    }


    mm.End();


    PipeBarrier<PIPE_ALL>();
}


// ============================================================================
// Host helpers
// ============================================================================

[[noreturn]]
inline void Fail()
{
    std::abort();
}


inline void CheckAcl(
    aclError result)
{
    if (result !=
        ACL_SUCCESS) {

        std::abort();
    }
}


inline void CheckTiling(
    int64_t result)
{
    if (result < 0) {
        std::abort();
    }
}


inline const TensorInfo &
SingleTensor(
    const TensorGroupInfo &info)
{
    if (
        info.numTensors != 1 ||
        info.tensors == nullptr ||
        info.tensors[0].shape ==
            nullptr
    ) {

        Fail();
    }


    return
        info.tensors[0];
}


// ============================================================================
// Metadata parsing
// ============================================================================

inline Shape ParseShape(
    const TensorGroupInfo &infoX1,
    const TensorGroupInfo &infoX2,
    const TensorGroupInfo &infoY,
    bool transposeX1,
    bool transposeX2)
{
    const TensorInfo &a =
        SingleTensor(infoX1);


    const TensorInfo &b =
        SingleTensor(infoX2);


    const TensorInfo &out =
        SingleTensor(infoY);


    if (
        a.numDims != 3 ||
        b.numDims != 3 ||
        out.numDims != 1
    ) {
        Fail();
    }


    if (
        a.dtype != b.dtype ||
        (
            a.dtype != 1 &&
            a.dtype != 2
        ) ||
        out.dtype != 0
    ) {
        Fail();
    }


    const int64_t B =
        a.shape[0];


    const int64_t M =
        a.shape[
            transposeX1
                ? 2
                : 1
        ];


    const int64_t K1 =
        a.shape[
            transposeX1
                ? 1
                : 2
        ];


    const int64_t K2 =
        b.shape[
            transposeX2
                ? 2
                : 1
        ];


    const int64_t N =
        b.shape[
            transposeX2
                ? 1
                : 2
        ];


    if (
        B <= 0 ||
        M <= 0 ||
        N <= 0 ||
        K1 <= 0 ||
        K2 <= 0 ||
        b.shape[0] != B ||
        K1 != K2 ||
        out.shape[0] != B
    ) {

        Fail();
    }


    Shape shape;


    shape.b =
        static_cast<uint32_t>(
            B);


    shape.m =
        static_cast<uint32_t>(
            M);


    shape.n =
        static_cast<uint32_t>(
            N);


    shape.k =
        static_cast<uint32_t>(
            K1);


    return shape;
}


// ============================================================================
// Four storage layouts
// ============================================================================

template <typename InputT>
inline void LaunchMatmulPath(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    GM_ADDR partial,
    GM_ADDR workspace,
    GM_ADDR cWorkspace,
    const CubeTiling &tiling,
    Shape shape,
    uint32_t blocks,
    uint32_t rowTiles,
    uint32_t nChunksTask,
    uint32_t wm,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    if (
        !transposeX1 &&
        !transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            false,
            false>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                partial,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks,
                nChunksTask,
                wm);
    }

    else if (
        !transposeX1 &&
        transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            false,
            true>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                partial,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks,
                nChunksTask,
                wm);
    }

    else if (
        transposeX1 &&
        !transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            true,
            false>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                partial,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks,
                nChunksTask,
                wm);
    }

    else {

        MatmulMaxKernel<
            InputT,
            true,
            true>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                partial,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks,
                nChunksTask,
                wm);
    }


    /*
     * Phase 2 runs on the host: a plain-AIV
     * second kernel launched behind the MIX
     * kernel proved unreliable in this stack
     * (its writes randomly never landed), so
     * the caller reduces partials on the CPU
     * after stream sync.
     */
}


// ============================================================================
// Launch
// ============================================================================

inline void Launch(
    GM_ADDR x1,
    const TensorGroupInfo &infoX1,
    GM_ADDR x2,
    const TensorGroupInfo &infoX2,
    GM_ADDR y,
    const TensorGroupInfo &infoY,
    int64_t availableCoreNum,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    const Shape shape =
        ParseShape(
            infoX1,
            infoX2,
            infoY,
            transposeX1,
            transposeX2);


    const int32_t inputDtype =
        infoX1
            .tensors[0]
            .dtype;


    const uint64_t macs =
        static_cast<uint64_t>(
            shape.b)
        *
        shape.m
        *
        shape.n
        *
        shape.k;


    // ------------------------------------------------------------------------
    // Tiny shape path
    // ------------------------------------------------------------------------

    if (
        macs <=
        SMALL_MAC_LIMIT
    ) {

        if (
            inputDtype == 1
        ) {

            SmallKernel<half>
                <<<1,
                   nullptr,
                   stream>>>(
                    x1,
                    x2,
                    y,
                    shape,
                    transposeX1,
                    transposeX2);
        }

        else {

            SmallKernel<bfloat16_t>
                <<<1,
                   nullptr,
                   stream>>>(
                    x1,
                    x2,
                    y,
                    shape,
                    transposeX1,
                    transposeX2);
        }


        return;
    }


    // ------------------------------------------------------------------------
    // Matmul path
    // ------------------------------------------------------------------------

    if (
        availableCoreNum <= 0
    ) {

        Fail();
    }


    platform_ascendc::
        PlatformAscendC *platform =

        platform_ascendc::
            PlatformAscendCManager::
                GetInstance();


    if (
        platform ==
        nullptr
    ) {

        Fail();
    }


    const uint32_t
        rowTiles =

        (
            shape.m +
            TILE_M - 1
        ) /
        TILE_M;


    const uint32_t
        realChunks =

        (
            shape.n +
            N_CHUNK - 1
        ) /
        N_CHUNK;


    const uint32_t
        nChunksTask =

        std::min<uint32_t>(
            realChunks,
            MAX_NCHUNK);


    const uint32_t
        hardwareCubeCores =

        platform
            ->GetCoreNumAic();


    if (
        hardwareCubeCores ==
        0
    ) {

        Fail();
    }


    const uint32_t tileN =

        std::min<uint32_t>(

            MAX_TILE_N,

            (
                (
                    shape.n +
                    15U
                ) /
                16U
            )
            *
            16U
        );


    const
    matmul_tiling::DataType
        inputType =

        inputDtype == 1

        ?
        matmul_tiling::
            DataType::
                DT_FLOAT16

        :
        matmul_tiling::
            DataType::
                DT_BFLOAT16;


    // ------------------------------------------------------------------------
    // Matmul tiling
    // ------------------------------------------------------------------------

    matmul_tiling::
        MatmulApiTiling
            tiler(*platform);


    CheckTiling(
        tiler.SetAType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            inputType,

            transposeX1
        )
    );


    CheckTiling(
        tiler.SetBType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            inputType,

            transposeX2
        )
    );


    CheckTiling(
        tiler.SetCType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            matmul_tiling::
                DataType::
                    DT_FLOAT
        )
    );


    CheckTiling(
        tiler.SetBias(
            false)
    );


    CheckTiling(
        tiler.SetOrgShape(
            shape.m,
            shape.n,
            shape.k)
    );


    /*
     * baseM must not exceed the declared single
     * shape M (tiler rejects FixSplit otherwise),
     * so clamp the requested fix-M down to the
     * problem M, 16-aligned. Tiny M keeps the
     * original baseM=16 behaviour. 128 was the
     * sweep optimum on 910C.
     */
    uint32_t fixM =
        std::max<uint32_t>(
            TILE_M,
            std::min<uint32_t>(
                128U,
                shape.m) &
                ~15U);


    CheckTiling(
        tiler.SetShape(

            std::min<uint32_t>(
                fixM,
                shape.m),

            shape.n,

            shape.k)
    );


    /*
     * L0C budget is 128 KiB on dav-2201: one
     * fp32 C tile needs baseM*baseN*4 bytes, so
     * baseN must shrink once fixM exceeds 128.
     * baseN also steers the tiler's baseK pick
     * (128x256->baseK64, 128x128->baseK128 on
     * 910C), which halves the K-loop step count.
     */
    const uint32_t fixN =
        std::min<uint32_t>(
            tileN,
            32768U /
                fixM);
    CheckTiling(
        tiler.SetFixSplit(
            fixM,
            fixN,
            -1)
    );


    CheckTiling(
        tiler.SetBufferSpace(
            -1,
            -1,
            -1)
    );


    CubeTiling tiling;


    CheckTiling(
        tiler.GetTiling(
            tiling)
    );



    /*
     * M window per task: bigger windows let one
     * single shape cover several 16-row blocks,
     * amortizing KFC round trips and (with
     * n-outer cube scheduling) reusing B strips
     * across m-blocks. Shrink the window until
     * the task grid still fills the AIV pool.
     */
    uint32_t wm =
        std::max<uint32_t>(
            TILE_M,
            tiling.baseM);

    {

        while (
            wm >
                tiling.baseM &&

            static_cast<uint64_t>(
                shape.b) *
                (
                    (
                        shape.m +
                        wm -
                        1
                    ) /
                    wm
                ) *
                nChunksTask <

            6U *
                hardwareCubeCores
        ) {

            wm >>=
                1;
        }
    }

    /* keep the window a whole number of m-blocks */
    wm =
        std::max<uint32_t>(
            tiling.baseM,
            wm /
                tiling.baseM *
                tiling.baseM);


    const uint32_t
        rowWins =

        (
            shape.m +
            wm -
            1
        ) /
        wm;


    const uint64_t
        totalTasks =

        static_cast<uint64_t>(
            shape.b) *
            rowWins *
            nChunksTask;


    uint32_t blocks =

        static_cast<uint32_t>(

            std::min<int64_t>(

                availableCoreNum,

                static_cast<int64_t>(
                    hardwareCubeCores)
            )
        );


    blocks =
        static_cast<uint32_t>(
            std::min<uint64_t>(
                blocks,
                totalTasks));


    if (
        blocks == 0
    ) {

        blocks = 1;
    }


    // ------------------------------------------------------------------------
    // Workspace
    // ------------------------------------------------------------------------

    const size_t systemBytes =

        std::max<size_t>(

            32,

            static_cast<size_t>(

                platform
                    ->GetLibApiWorkSpaceSize()
            )
        );


    void *systemDevice =
        nullptr;


    CheckAcl(
        aclrtMalloc(

            &systemDevice,

            systemBytes,

            ACL_MEM_MALLOC_HUGE_FIRST)
    );


    CheckAcl(
        aclrtMemset(

            systemDevice,

            systemBytes,

            0,

            systemBytes)
    );


    CheckAcl(
        aclrtMemset(

            y,

            static_cast<size_t>(
                shape.b) *
                sizeof(float),

            0,

            static_cast<size_t>(
                shape.b) *
                sizeof(float))
    );


    /*
     * Per-execution-unit GM scratch for the
     * IterateAll slot grid (mBlocks x nTiles
     * tiles of baseM x baseN): 2 AIV slots per
     * block plus a shifted slot per AIC
     * (3 * blocks total), one spare row-block
     * of slack per slot.
     */
    /*
     * Tight slot sizing: one task emits at most
     * ceil(wm/baseM) m-blocks x ceil(N_CHUNK/
     * baseN) n-tiles of baseM x baseN each.
     */
    const size_t cBytes =

        static_cast<size_t>(
            blocks) *
        3U *
        (
            (
                wm +
                tiling.baseM -
                1U
            ) /
                tiling.baseM
        ) *
        (
            (
                N_CHUNK +
                tiling.baseN -
                1U
            ) /
                tiling.baseN
        ) *
        static_cast<size_t>(
            tiling.baseM) *
        tiling.baseN *
        sizeof(float);


    void *cDevice =
        nullptr;


    CheckAcl(
        aclrtMalloc(

            &cDevice,

            cBytes,

            ACL_MEM_MALLOC_HUGE_FIRST)
    );


    /*
     * Phase-1 -> phase-2 row-max partials:
     * one TILE_M slot per (batch,mwin16,chunk)
     * — a wm-row task writes wm/TILE_M slots.
     * Fully written by owners before the
     * reduction reads them, so no memset.
     */
    const size_t partialBytes =

        static_cast<size_t>(
            shape.b) *
        rowTiles *
        nChunksTask *
        TILE_M *
        sizeof(float);


    void *pDevice =
        nullptr;


    CheckAcl(
        aclrtMalloc(

            &pDevice,

            partialBytes,

            ACL_MEM_MALLOC_HUGE_FIRST)
    );


    // ------------------------------------------------------------------------
    // Cube + Vector MaxSim + Sum fused in one launch
    // ------------------------------------------------------------------------

    if (
        inputDtype == 1
    ) {

        LaunchMatmulPath<half>(

            x1,

            x2,

            y,

            (GM_ADDR)pDevice,

            (GM_ADDR)systemDevice,

            (GM_ADDR)cDevice,

            tiling,

            shape,

            blocks,

            rowTiles,

            nChunksTask,

            wm,

            stream,

            transposeX1,

            transposeX2
        );
    }

    else {

        LaunchMatmulPath<
            bfloat16_t>(

            x1,

            x2,

            y,

            (GM_ADDR)pDevice,

            (GM_ADDR)systemDevice,

            (GM_ADDR)cDevice,

            tiling,

            shape,

            blocks,

            rowTiles,

            nChunksTask,

            wm,

            stream,

            transposeX1,

            transposeX2
        );
    }


    /*
     * workspace 在本函数内部申请，
     * 所以释放前必须确保该 stream
     * 已经完成访问。
     */
    CheckAcl(
        aclrtSynchronizeStreamWithTimeout(
            stream,
            3000)
    );


    /*
     * Phase 2 on host: merge per-chunk row
     * maxima and accumulate rows in
     * (mwin,row) ascending order — the same
     * association order the serial kernel
     * used, so results stay bitwise stable.
     */
    std::vector<float>
        hostPartial(
            static_cast<size_t>(
                shape.b) *
            rowTiles *
            nChunksTask *
            TILE_M);


    CheckAcl(
        aclrtMemcpy(
            hostPartial.data(),
            hostPartial.size() *
                sizeof(float),
            pDevice,
            hostPartial.size() *
                sizeof(float),
            ACL_MEMCPY_DEVICE_TO_HOST)
    );


    std::vector<float>
        hostY(
            shape.b);


    for (uint32_t batch = 0;
         batch < shape.b;
         ++batch) {

        float batchSum = 0.0f;


        for (uint32_t mwin = 0;
             mwin < rowTiles;
             ++mwin) {

            const uint32_t validM =
                std::min<uint32_t>(
                    TILE_M,
                    shape.m -
                        mwin * TILE_M);


            const uint64_t base =
                (
                    static_cast<uint64_t>(
                        batch) *
                        rowTiles +
                    mwin
                ) *
                nChunksTask;


            float rowMax[TILE_M];


            for (uint32_t r = 0;
                 r < validM;
                 ++r) {

                rowMax[r] =
                    -3.402823466e38f;
            }


            for (uint32_t c = 0;
                 c < nChunksTask;
                 ++c) {

                const float *slot =
                    hostPartial.data() +
                    (base + c) *
                        TILE_M;


                for (uint32_t r = 0;
                     r < validM;
                     ++r) {

                    if (slot[r] > rowMax[r]) {
                        rowMax[r] =
                            slot[r];
                    }
                }
            }


            for (uint32_t r = 0;
                 r < validM;
                 ++r) {

                batchSum +=
                    rowMax[r];
            }
        }


        hostY[batch] =
            batchSum;
    }


    CheckAcl(
        aclrtMemcpy(
            y,
            static_cast<size_t>(
                shape.b) *
                sizeof(float),
            hostY.data(),
            static_cast<size_t>(
                shape.b) *
                sizeof(float),
            ACL_MEMCPY_HOST_TO_DEVICE)
    );


    CheckAcl(
        aclrtFree(
            pDevice)
    );


    CheckAcl(
        aclrtFree(
            cDevice)
    );


    CheckAcl(
        aclrtFree(
            systemDevice)
    );
}

} // namespace bmmms


// ============================================================================
// Contest ABI
// ============================================================================

extern "C" void run_kernel(
    GM_ADDR x1,
    const TensorGroupInfo &info_x1,

    GM_ADDR x2,
    const TensorGroupInfo &info_x2,

    GM_ADDR y,
    const TensorGroupInfo &info_y,

    int64_t availableCoreNum,

    aclrtStream stream,

    bool transposeX1,

    bool transposeX2)
{
    bmmms::Launch(

        x1,
        info_x1,

        x2,
        info_x2,

        y,
        info_y,

        availableCoreNum,

        stream,

        transposeX1,

        transposeX2
    );
}