// ============================================================================
// kernel.asc — BatchMatmulMaxSum @ 910C (Atlas A3 / __NPU_ARCH__=2201)
//
// 基线 = 队友 push 的 origin/main（f5b3995，kernel.asc blob 3e96fd39，真机 15/15）。
// 本版只改「AIV 与 AIC 之间穿过 GM 的次数」，数学语义、任务划分、输出写回方式不变。
//
// 两条杠杆（完整推导与文档出处见下方 MatmulMaxKernel 前的长注释）：
//   [1] 分片顶到 L0C 满存：16×256=4096 → **128×256=32768**（正好 128KB L0C）
//       ⇒ 分片数 = Fixpipe 写 GM 次数 = GetTensorC 同步次数，降 8 倍；
//       每次搬运的块也大 8 倍（128KB 级），搬运次数越少、单次越满。
//   [2] 同一行块的 N 个分片用 GetTensorC(..., enAtomic=2) 就地 AtomicMax 归并
//       ⇒ AIV 每行块只从 GM 读 1 次，且这次读就是 128KB（UB 192KB 的 2/3）。
//   N 尾块不参与归并：独立槽位 + 基线已实测的标量逐行读法（123b2b8 的结论）。
//   tiler 若拒绝 256 列的分片，Launch 按 64 列一档退让（回读值驱动，不猜）。
//
// 每行块的 GM 往返账：旧版 2 × (n/baseN) 次 16KB 级 → 本版 (n/baseN) 写 + 1 读，
// 且每次 128KB 级（分片 = L0C 满存）。
//
// ⚠ 本机没有 CANN / NPU：本文件**未编译、未上板**。上板必查清单见文件末尾 VERIFY。
// ============================================================================

#include <cstdint>
#include <cstdlib>
#include <algorithm>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"

namespace bmmms {

using namespace AscendC;
using CubeTiling = AscendC::tiling::TCubeTiling;

/*
 * 分片上限 —— 目标是让 **L0C 满存**。
 *   平台 L0C = 128KB，C 矩阵 float ⇒ 单个分片最多 baseM*baseN*4 = 131072
 *   ⇒ baseM * baseN <= 32768。取 128 x 256 = 32768（正好 128KB，dbL0C 只能是 1）。
 *   分片面积越大，分片数越少 ⇒ Fixpipe 写 GM 次数越少、GetTensorC 同步次数越少；
 *   同时 AIV 侧的归并缓冲变成 128x256x4 = 128KB，每次 GM->UB 搬运把 UB 铺得更满。
 *   旧的 16 x 256 = 4096（L0C 只用 16KB/128KB）⇒ 分片数差 8 倍。
 *   tiler 若因 L0A/L0B/L1 约束拒绝这个分片，Launch 会按 64 列一档退让（见那里的注释）。
 */
static constexpr uint32_t MAX_BASE_M = 128;
static constexpr uint32_t MAX_TILE_N = 256;
static constexpr uint64_t SMALL_MAC_LIMIT = 32768;
static constexpr float NEG_INF = -3.402823466e38f;

struct Shape {
    uint32_t b;
    uint32_t m;
    uint32_t n;
    uint32_t k;
};


// ============================================================================
// Device helpers
// ============================================================================

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

__aicore__ inline float AbsF32(float x)
{
    return x < 0.0f ? -x : x;
}

__aicore__ inline float Decode(half x)
{
    return static_cast<float>(x);
}

__aicore__ inline float Decode(bfloat16_t x)
{
    return AscendC::ToFloat(x);
}

__aicore__ inline void AddCompensated(
    float value,
    float &sum,
    float &correction)
{
    const float next = sum + value;

    if (AbsF32(sum) >= AbsF32(value)) {
        correction += (sum - next) + value;
    } else {
        correction += (value - next) + sum;
    }

    sum = next;
}

template <HardEvent E>
__aicore__ inline void Fence(TPipe &pipe)
{
    const event_t event =
        static_cast<event_t>(
            pipe.FetchEventID(E));

    SetFlag<E>(event);
    WaitFlag<E>(event);
}


// ============================================================================
// Small-input path
// ============================================================================

template <typename InputT>
__global__ __aicore__ void SmallKernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    Shape shape,
    bool transposeX1,
    bool transposeX2)
{
    if (GetBlockIdx() != 0) {
        return;
    }

    TPipe pipe;

    TBuf<TPosition::VECCALC> outBuf;

    pipe.InitBuffer(
        outBuf,
        64 * sizeof(float));

    LocalTensor<float> outLocal =
        outBuf.Get<float>();


    GlobalTensor<InputT> a;
    GlobalTensor<InputT> b;
    GlobalTensor<float> out;


    a.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x1),
        static_cast<uint64_t>(shape.b) *
            shape.m *
            shape.k);


    b.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x2),
        static_cast<uint64_t>(shape.b) *
            shape.n *
            shape.k);


    out.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(y),
        shape.b);


    for (uint32_t batch = 0;
         batch < shape.b;
         ++batch) {

        const uint64_t aBase =
            static_cast<uint64_t>(batch) *
            shape.m *
            shape.k;


        const uint64_t bBase =
            static_cast<uint64_t>(batch) *
            shape.n *
            shape.k;


        float total = 0.0f;
        float totalCorr = 0.0f;


        for (uint32_t row = 0;
             row < shape.m;
             ++row) {

            float best = 0.0f;


            for (uint32_t col = 0;
                 col < shape.n;
                 ++col) {

                float dot = 0.0f;
                float dotCorr = 0.0f;


                for (uint32_t kk = 0;
                     kk < shape.k;
                     ++kk) {

                    const uint64_t aOffset =
                        aBase +
                        (
                            transposeX1
                                ?
                                static_cast<uint64_t>(kk) *
                                        shape.m +
                                    row
                                :
                                static_cast<uint64_t>(row) *
                                        shape.k +
                                    kk
                        );


                    const uint64_t bOffset =
                        bBase +
                        (
                            transposeX2
                                ?
                                static_cast<uint64_t>(col) *
                                        shape.k +
                                    kk
                                :
                                static_cast<uint64_t>(kk) *
                                        shape.n +
                                    col
                        );


                    const float product =
                        Decode(
                            a.GetValue(aOffset)
                        )
                        *
                        Decode(
                            b.GetValue(bOffset)
                        );


                    AddCompensated(
                        product,
                        dot,
                        dotCorr);
                }


                const float score =
                    dot + dotCorr;


                if (col == 0 ||
                    score > best) {

                    best = score;
                }
            }


            AddCompensated(
                best,
                total,
                totalCorr);
        }


        outLocal.SetValue(
            batch,
            total + totalCorr);
    }


    Fence<HardEvent::S_MTE3>(
        pipe);


    DataCopyExtParams copyOut;

    copyOut.blockCount = 1;

    copyOut.blockLen =
        shape.b *
        sizeof(float);

    copyOut.srcStride = 0;
    copyOut.dstStride = 0;
    copyOut.rsv = 0;


    DataCopyPad(
        out,
        outLocal,
        copyOut);


    Fence<HardEvent::MTE3_S>(
        pipe);


    PipeBarrier<PIPE_ALL>();
}


// ============================================================================
// Cube Matmul + Vector MaxSim
// ============================================================================
//
// 本版唯一目标：把 AIV 与 AIC 之间**穿过 GM 的次数**压到平台允许的下限。
//
// 平台事实（`910D_knowledge_extra/220x到351x架构变更.md:120-165`）：L0C→UB 直通是
// **351x 才新增**的通路（"新增L0C Buffer到UB的单向数据通路"）。本题实测架构是
// 220x（DAV_2201），没有它 —— 所以每块 C 分片必须由 Fixpipe 写一次 GM、再由 AIV
// 读回来，这条路径绕不开。既然绕不开，就只剩两个杠杆：
//
//   [杠杆 1] 分片面积最大（= 让 L0C 满存）→ 分片数最少 → 写次数最少。
//     L0C = 128KB、C 为 float ⇒ baseM*baseN*4 ≤ 131072 ⇒ baseM*baseN ≤ 32768。
//     取 128×256 = 32768（正好 128KB，dbL0C = 1）。tiler 若拒绝就按 64 列退让。
//     旧的 16×256 = 4096/片（L0C 只用 16KB/128KB）⇒ 分片数差 8 倍。
//
//   [杠杆 2] 同一行块的 N 个分片在 GM 上**就地归并**，AIV 每行块只读 1 次，
//     而且这次读的大小 = baseM*baseN*4 = 128KB，把 UB(192KB) 铺到 2/3 满。
//     mm.GetTensorC(cAcc, enAtomic, true)，enAtomic = 2 即 AtomicMax
//     （`GetTensorC.md:100`：0=无、1=AtomicAdd、2=AtomicMax；A2/A3 支持）。
//     原子通路本身在 A2/A3 上包含 L0C->GM 且支持 float（`SetAtomicAdd.md:31`、
//     `SetAtomicMax（ISASI）.md:9-27`）。
//     每行块第 1 片用 enAtomic=0 普通写 —— 它同时充当初值：原子操作**不会**清零
//     （`SetAtomicAdd.md:47`），所以无法用 -inf 预置 GM。其后各片 AtomicMax 累到
//     同一地址，一个行块只占一个 [baseM, baseN] 缓冲。
//
// 为什么正确性不受影响：
//   * max 可交换可结合 ⇒ AtomicMax 的合并顺序无关，结果**逐位确定**。
//     这一点比 AtomicAdd 强：后者会因调度顺序漂末位，而题面要求多次执行结果一致。
//   * N 尾块（n % baseN != 0）**不参与**原子归并：连续写在尾块按 validN 紧凑打包，
//     平坦下标与整块不同构（123b2b8 实测结论），混进归并缓冲会跨行串列。
//     尾块写独立槽位，走 15/15 已验证的标量逐行读法，再 Max 回行最大值。
//   * 行最大值改用 WholeReduceMax（一次算完整个分片的所有行），替代每行一次
//     ReduceMax，向量侧调用数从 m*(n/baseN) 降到 m/(n/baseN) 量级。
//
// 单个行块（baseM 行）的 GM 往返账：
//   写：n/baseN 次，每次一个满 L0C 分片（128KB）；读：**1** 次，一次 128KB；
//   N 尾块存在时额外 1 写 + 1 读（仅 n%baseN != 0 的 case）。
//   对比：基线每行块 2×(n/256) 次 16KB 级往返；本版是 (n/256) 次 128KB 写 + 1 次 128KB 读。
// ============================================================================

template <
    typename InputT,
    bool TRANSPOSE_A,
    bool TRANSPOSE_B>
__global__ __aicore__ void MatmulMaxKernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    __kfc_workspace__ GM_ADDR systemWorkspace,
    GM_ADDR cWorkspace,
    CubeTiling tiling,
    Shape shape,
    uint32_t workerCount)
{
    TPipe pipe;


    using AType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            InputT,
            TRANSPOSE_A>;


    using BType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            InputT,
            TRANSPOSE_B>;


    using CType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            float>;


    Matmul<
        AType,
        BType,
        CType> mm;


    REGIST_MATMUL_OBJ(
        &pipe,
        GetSysWorkSpacePtr(),
        mm,
        &tiling);


    /*
     * UB 缓冲按**编译期上限**分配（MAX_BASE_M × MAX_TILE_N），实际尺寸全部取自
     * tiling 回读值 —— host 侧已校验回读值不超上限，所以这里不会越界。
     */
    TBuf<TPosition::VECCALC> cTileBuf;
    TBuf<TPosition::VECCALC> passMaxBuf;
    TBuf<TPosition::VECCALC> rowMaxBuf;
    TBuf<TPosition::VECCALC> tailMaxBuf;
    TBuf<TPosition::VECCALC> rowOutBuf;


    pipe.InitBuffer(
        cTileBuf,
        MAX_BASE_M *
            MAX_TILE_N *
            sizeof(float));


    pipe.InitBuffer(
        passMaxBuf,
        MAX_BASE_M *
            sizeof(float));


    pipe.InitBuffer(
        rowMaxBuf,
        MAX_BASE_M *
            sizeof(float));


    pipe.InitBuffer(
        tailMaxBuf,
        MAX_BASE_M *
            sizeof(float));


    pipe.InitBuffer(
        rowOutBuf,
        MAX_BASE_M *
            sizeof(float));


    LocalTensor<float>
        cUb =
            cTileBuf.Get<float>();


    LocalTensor<float>
        passMax =
            passMaxBuf.Get<float>();


    LocalTensor<float>
        rowMaxVec =
            rowMaxBuf.Get<float>();


    LocalTensor<float>
        tailMaxVec =
            tailMaxBuf.Get<float>();


    LocalTensor<float>
        rowOut =
            rowOutBuf.Get<float>();


    /*
     * tiling 回读值。host 侧（Launch）已经校验：
     *   baseM ≥ min(splitM, m) 且 ≤ MAX_BASE_M、baseN ≤ MAX_TILE_N、baseN % 8 == 0。
     * 由此 mBlocks = ceil(validM/baseM) 恒为 1，Iterate 的产出顺序就是 N 升序。
     */
    const uint32_t baseM =
        static_cast<uint32_t>(
            tiling.baseM);


    const uint32_t baseN =
        static_cast<uint32_t>(
            tiling.baseN);


    const uint32_t
        nFullTiles =
            shape.n /
            baseN;


    const uint32_t
        tailN =
            shape.n -
            nFullTiles *
                baseN;


    /* 行距（datablock = 32B = 8 个 fp32）。 */
    const uint32_t
        rowPitchBlocks =
            baseN >>
            3;


    /* 每行 64 列做一次 WholeReduceMax（fp32 一次迭代上限 64 个元素）。 */
    const uint32_t
        reducePasses =
            (
                baseN +
                63U
            ) >>
            6;


    GlobalTensor<InputT> a;
    GlobalTensor<InputT> b;
    GlobalTensor<float> out;


    a.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x1),

        static_cast<uint64_t>(
            shape.b) *
            shape.m *
            shape.k);


    b.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x2),

        static_cast<uint64_t>(
            shape.b) *
            shape.n *
            shape.k);


    out.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(y),

        static_cast<uint64_t>(
            shape.b));


    const uint32_t worker =
        static_cast<uint32_t>(
            GetBlockIdx());


    /*
     * AIV 的 GetBlockIdx() 枚举 [0, 2*blocks)，AIC 侧从 0 重新枚举，
     * 因此 AIC 的槽位整体后移 2*blocks，避免误抄到 AIV 的槽位。
     */
    const uint32_t workers =
        workerCount;


    uint32_t cSlot =
        worker;

    if
        ASCEND_IS_AIV
    {
        cSlot = worker;
    } else {
        cSlot =
            workers +
            worker;
    }


    /*
     * 每个 worker 一个槽位，槽位内分两半：
     *   前半 cAcc：整分片的原子归并缓冲（一个 [baseM, baseN] 就够，因为就地归并）；
     *   后半 cTail：N 尾块的独立缓冲（不能与归并缓冲共用，见文件头）。
     * host 侧按同样公式申请（3 * blocks * 槽位元素数）。
     */
    static constexpr uint32_t
        SLOT_ELEMS =
            2U *
            MAX_BASE_M *
            MAX_TILE_N;


    GlobalTensor<float> cAcc;
    GlobalTensor<float> cTail;


    cAcc.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(cWorkspace) +
            static_cast<uint64_t>(
                cSlot) *
                SLOT_ELEMS,

        MAX_BASE_M *
            MAX_TILE_N);


    cTail.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(cWorkspace) +
            static_cast<uint64_t>(
                cSlot) *
                SLOT_ELEMS +
            (
                MAX_BASE_M *
                MAX_TILE_N),

        MAX_BASE_M *
            MAX_TILE_N);


    /*
     * 一个 task = 一个 batch：属主 AIV 走完它的所有行块，行和累在寄存器里，
     * 最后只写一个 float 到 y[batch]。无原子、无跨 worker 累加、无第二阶段。
     */
    for (uint32_t task = worker;
         task < shape.b;
         task += workers) {

        const uint32_t batch =
            task;


        float batchSum = 0.0f;


        for (uint32_t rowStart = 0;
             rowStart < shape.m;
             rowStart += baseM) {

        const uint32_t validM =
            MinU32(
                baseM,
                shape.m -
                    rowStart);


        const uint64_t aOffset =
            static_cast<uint64_t>(
                batch) *
                shape.m *
                shape.k
            +
            (
                TRANSPOSE_A
                    ?
                    static_cast<uint64_t>(
                        rowStart)
                    :
                    static_cast<uint64_t>(
                        rowStart) *
                        shape.k
            );


        const uint64_t bOffset =
            static_cast<uint64_t>(
                batch) *
            shape.n *
            shape.k;


        Duplicate(
            rowMaxVec,
            NEG_INF,
            static_cast<int32_t>(
                MAX_BASE_M));


        mm.SetOrgShape(
            shape.m,
            shape.n,
            shape.k);


        mm.SetSingleShape(
            validM,
            shape.n,
            shape.k);


        mm.SetTensorA(
            a[aOffset],
            TRANSPOSE_A);


        mm.SetTensorB(
            b[bOffset],
            TRANSPOSE_B);


        /*
         * 分片循环：整片（N 升序）原子归并到 cAcc 同一地址，N 尾片单独落 cTail。
         * 第 0 片用普通写 = 归并缓冲的初值，第 1 片起才 AtomicMax。
         */
        uint32_t tileIdx = 0;
        bool tailSeen = false;


        while (mm.Iterate()) {

            if (tileIdx < nFullTiles) {

                mm.GetTensorC(
                    cAcc,
                    static_cast<uint8_t>(
                        tileIdx == 0U
                            ? 0U
                            : 2U),
                    true);

            } else {

                /*
                 * 尾片：普通写。先显式关掉原子模式，避免它残留到普通写/后续搬运上。
                 */
                SetAtomicNone();


                mm.GetTensorC(
                    cTail,
                    0U,
                    true);


                tailSeen = true;
            }


            ++tileIdx;
        }


        /*
         * 归并缓冲只读一次 —— 这是本版相对旧版的关键差别：
         * 旧版每个 N 分片都要从 GM 读回一次 [baseM, baseN]。
         */
        if (nFullTiles > 0U) {

            Fence<
                HardEvent::V_MTE2>(
                    pipe);


            DataCopyExtParams
                copyAcc;

            copyAcc.blockCount =
                static_cast<uint16_t>(
                    validM);

            copyAcc.blockLen =
                baseN *
                sizeof(float);

            copyAcc.srcStride = 0;
            copyAcc.dstStride = 0;
            copyAcc.rsv = 0;


            DataCopyPadExtParams<float>
                padAcc;


            DataCopyPad(
                cUb,
                cAcc,
                copyAcc,
                padAcc);


            Fence<
                HardEvent::MTE2_V>(
                    pipe);


            /*
             * 行最大值：每个 pass 覆盖 64 列，一次算完 validM 行的最大值，
             * 比逐行 ReduceMax 少 (n/baseN) 倍的调用次数。
             */
            for (uint32_t pass = 0;
                 pass < reducePasses;
                 ++pass) {

                const uint32_t columns =
                    MinU32(
                        64U,
                        baseN -
                            pass *
                                64U);


                WholeReduceMax(
                    passMax,
                    cUb[
                        pass *
                        64U],
                    static_cast<int32_t>(
                        columns),
                    static_cast<int32_t>(
                        validM),
                    1,
                    1,
                    static_cast<int32_t>(
                        rowPitchBlocks),
                    ReduceOrder::
                        ORDER_ONLY_VALUE);


                Max(
                    rowMaxVec,
                    rowMaxVec,
                    passMax,
                    static_cast<int32_t>(
                        validM));
            }
        }


        /*
         * N 尾块：连续写在尾块按 validN 紧凑打包，所以行距是 tailN，
         * 行首不再 32B 对齐 —— 沿用 15/15 版本验证过的标量逐行读法。
         */
        if (tailSeen) {

            Fence<
                HardEvent::V_MTE2>(
                    pipe);


            DataCopyExtParams
                copyTail;

            copyTail.blockCount = 1;

            copyTail.blockLen =
                validM *
                tailN *
                sizeof(float);

            copyTail.srcStride = 0;
            copyTail.dstStride = 0;
            copyTail.rsv = 0;


            DataCopyPadExtParams<float>
                padTail;


            DataCopyPad(
                cUb,
                cTail,
                copyTail,
                padTail);


            Fence<
                HardEvent::MTE2_V>(
                    pipe);


            Duplicate(
                tailMaxVec,
                NEG_INF,
                static_cast<int32_t>(
                    MAX_BASE_M));


            Fence<
                HardEvent::V_S>(
                    pipe);


            for (uint32_t row = 0;
                 row < validM;
                 ++row) {

                float rowBest =
                    NEG_INF;

                const uint32_t srcBase =
                    row *
                    tailN;

                for (uint32_t col = 0;
                     col < tailN;
                     ++col) {

                    const float v =
                        cUb.GetValue(
                            srcBase + col);

                    if (v > rowBest) {
                        rowBest = v;
                    }
                }


                tailMaxVec.SetValue(
                    row,
                    rowBest);
            }


            Fence<
                HardEvent::S_V>(
                    pipe);


            Max(
                rowMaxVec,
                rowMaxVec,
                tailMaxVec,
                static_cast<int32_t>(
                    validM));
        }


        Fence<
            HardEvent::V_S>(
                pipe);


        float tileSum = 0.0f;


        for (uint32_t row = 0;
             row < validM;
             ++row) {

            tileSum +=
                rowMaxVec
                    .GetValue(row);
        }


        batchSum += tileSum;


        Fence<
            HardEvent::S_V>(
                pipe);
        }


        if
            ASCEND_IS_AIV
        {

            rowOut.SetValue(
                0,
                batchSum);


            Fence<
                HardEvent::S_MTE3>(
                    pipe);


            DataCopyExtParams
                copyOut;

            copyOut.blockCount = 1;

            copyOut.blockLen =
                sizeof(float);

            copyOut.srcStride = 0;
            copyOut.dstStride = 0;
            copyOut.rsv = 0;


            DataCopyPad(
                out[
                    batch
                ],
                rowOut,
                copyOut);


            Fence<
                HardEvent::MTE3_S>(
                    pipe);
        }
    }


    mm.End();


    PipeBarrier<PIPE_ALL>();
}


// ============================================================================
// Host helpers
// ============================================================================

[[noreturn]]
inline void Fail()
{
    std::abort();
}


inline void CheckAcl(
    aclError result)
{
    if (result !=
        ACL_SUCCESS) {

        std::abort();
    }
}


inline void CheckTiling(
    int64_t result)
{
    if (result < 0) {
        std::abort();
    }
}


inline const TensorInfo &
SingleTensor(
    const TensorGroupInfo &info)
{
    if (
        info.numTensors != 1 ||
        info.tensors == nullptr ||
        info.tensors[0].shape ==
            nullptr
    ) {

        Fail();
    }


    return
        info.tensors[0];
}


// ============================================================================
// Metadata parsing
// ============================================================================

inline Shape ParseShape(
    const TensorGroupInfo &infoX1,
    const TensorGroupInfo &infoX2,
    const TensorGroupInfo &infoY,
    bool transposeX1,
    bool transposeX2)
{
    const TensorInfo &a =
        SingleTensor(infoX1);


    const TensorInfo &b =
        SingleTensor(infoX2);


    const TensorInfo &out =
        SingleTensor(infoY);


    if (
        a.numDims != 3 ||
        b.numDims != 3 ||
        out.numDims != 1
    ) {
        Fail();
    }


    if (
        a.dtype != b.dtype ||
        (
            a.dtype != 1 &&
            a.dtype != 2
        ) ||
        out.dtype != 0
    ) {
        Fail();
    }


    const int64_t B =
        a.shape[0];


    const int64_t M =
        a.shape[
            transposeX1
                ? 2
                : 1
        ];


    const int64_t K1 =
        a.shape[
            transposeX1
                ? 1
                : 2
        ];


    const int64_t K2 =
        b.shape[
            transposeX2
                ? 2
                : 1
        ];


    const int64_t N =
        b.shape[
            transposeX2
                ? 1
                : 2
        ];


    if (
        B <= 0 ||
        M <= 0 ||
        N <= 0 ||
        K1 <= 0 ||
        K2 <= 0 ||
        b.shape[0] != B ||
        K1 != K2 ||
        out.shape[0] != B
    ) {

        Fail();
    }


    Shape shape;


    shape.b =
        static_cast<uint32_t>(
            B);


    shape.m =
        static_cast<uint32_t>(
            M);


    shape.n =
        static_cast<uint32_t>(
            N);


    shape.k =
        static_cast<uint32_t>(
            K1);


    return shape;
}


// ============================================================================
// Four storage layouts
// ============================================================================

template <typename InputT>
inline void LaunchMatmulPath(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    GM_ADDR workspace,
    GM_ADDR cWorkspace,
    const CubeTiling &tiling,
    Shape shape,
    uint32_t blocks,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    if (
        !transposeX1 &&
        !transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            false,
            false>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else if (
        !transposeX1 &&
        transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            false,
            true>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else if (
        transposeX1 &&
        !transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            true,
            false>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else {

        MatmulMaxKernel<
            InputT,
            true,
            true>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }
}


// ============================================================================
// Launch
// ============================================================================

inline void Launch(
    GM_ADDR x1,
    const TensorGroupInfo &infoX1,
    GM_ADDR x2,
    const TensorGroupInfo &infoX2,
    GM_ADDR y,
    const TensorGroupInfo &infoY,
    int64_t availableCoreNum,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    const Shape shape =
        ParseShape(
            infoX1,
            infoX2,
            infoY,
            transposeX1,
            transposeX2);


    const int32_t inputDtype =
        infoX1
            .tensors[0]
            .dtype;


    const uint64_t macs =
        static_cast<uint64_t>(
            shape.b)
        *
        shape.m
        *
        shape.n
        *
        shape.k;


    // ------------------------------------------------------------------------
    // Tiny shape path
    // ------------------------------------------------------------------------

    if (
        macs <=
        SMALL_MAC_LIMIT
    ) {

        if (
            inputDtype == 1
        ) {

            SmallKernel<half>
                <<<1,
                   nullptr,
                   stream>>>(
                    x1,
                    x2,
                    y,
                    shape,
                    transposeX1,
                    transposeX2);
        }

        else {

            SmallKernel<bfloat16_t>
                <<<1,
                   nullptr,
                   stream>>>(
                    x1,
                    x2,
                    y,
                    shape,
                    transposeX1,
                    transposeX2);
        }


        return;
    }


    // ------------------------------------------------------------------------
    // Matmul path
    // ------------------------------------------------------------------------

    if (
        availableCoreNum <= 0
    ) {

        Fail();
    }


    platform_ascendc::
        PlatformAscendC *platform =

        platform_ascendc::
            PlatformAscendCManager::
                GetInstance();


    if (
        platform ==
        nullptr
    ) {

        Fail();
    }


    /*
     * baseM/baseN 只按 16 对齐后申请（`SetFixSplit.md` 要求 baseM <= ceil16(singleM)），
     * 实际值一律以 tiler 回读为准，回读值同时决定 UB 缓冲与 GM 槽位的几何。
     */
    const uint32_t splitM =

        std::min<uint32_t>(

            MAX_BASE_M,

            (
                (
                    shape.m +
                    15U
                ) /
                16U
            ) *
            16U);


    const uint32_t
        rowTilesPerBatch =

        (
            shape.m +
            splitM - 1
        ) /
        splitM;


    const uint32_t
        totalRowTiles =

        shape.b *
        rowTilesPerBatch;


    const uint32_t
        hardwareCubeCores =

        platform
            ->GetCoreNumAic();


    if (
        hardwareCubeCores ==
        0
    ) {

        Fail();
    }


    uint32_t blocks =

        static_cast<uint32_t>(

            std::min<int64_t>(

                availableCoreNum,

                static_cast<int64_t>(
                    hardwareCubeCores)
            )
        );


    blocks =
        std::min<uint32_t>(
            blocks,
            totalRowTiles);


    if (
        blocks == 0
    ) {

        blocks = 1;
    }


    const uint32_t splitN =

        std::min<uint32_t>(

            MAX_TILE_N,

            (
                (
                    shape.n +
                    15U
                ) /
                16U
            )
            *
            16U
        );


    const
    matmul_tiling::DataType
        inputType =

        inputDtype == 1

        ?
        matmul_tiling::
            DataType::
                DT_FLOAT16

        :
        matmul_tiling::
            DataType::
                DT_BFLOAT16;


    // ------------------------------------------------------------------------
    // Matmul tiling
    // ------------------------------------------------------------------------

    matmul_tiling::
        MatmulApiTiling
            tiler(*platform);


    CheckTiling(
        tiler.SetAType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            inputType,

            transposeX1
        )
    );


    CheckTiling(
        tiler.SetBType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            inputType,

            transposeX2
        )
    );


    CheckTiling(
        tiler.SetCType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            matmul_tiling::
                DataType::
                    DT_FLOAT
        )
    );


    CheckTiling(
        tiler.SetBias(
            false)
    );


    CheckTiling(
        tiler.SetOrgShape(
            shape.m,
            shape.n,
            shape.k)
    );


    CheckTiling(
        tiler.SetShape(

            std::min<uint32_t>(
                splitM,
                shape.m),

            shape.n,

            shape.k)
    );


    CheckTiling(
        tiler.SetBufferSpace(
            -1,
            -1,
            -1)
    );


    /*
     * 先把分片一路顶到 L0C 满存（baseN = 256 ⇒ 128x256x4 = 131072 = L0C），
     * 被 tiler 拒绝（L0A/L0B/L1 放不下对应的 baseK 等）就按 64 列一档退让，
     * 退到 64 还不行就 Fail。**由 GetTiling 的返回值驱动**，不靠猜。
     *
     * 为什么值得这么做：分片面积 = L0C 占用，直接决定
     *   * Fixpipe 写 GM 的次数（= 分片数），
     *   * GetTensorC 的同步次数（同样 = 分片数），
     *   * AIV 归并缓冲的大小（= baseM*baseN*4，决定每次 GM->UB 搬运有多满）。
     * 回读值才是 kernel 真正用的几何，所以"退让"只是少赚，不会改变语义。
     */
    CubeTiling tiling;

    int32_t chosenN = 0;

    for (int32_t request = static_cast<int32_t>(
             splitN);
         request >= 64;
         request -= 64) {

        if (
            tiler.SetFixSplit(
                splitM,
                request,
                -1) != 0
        ) {

            continue;
        }

        if (
            tiler.GetTiling(
                tiling) == 0
        ) {

            chosenN = request;

            break;
        }
    }


    if (chosenN == 0) {

        Fail();
    }


    /*
     * 用最终选定的配置**重算一次**，保证拿到的 tiling 来自一次干净的
     * setter -> getter（与基线完全同构），而不是多次试探后的残留状态。
     */
    CheckTiling(
        tiler.SetFixSplit(
            splitM,
            chosenN,
            -1)
    );


    CheckTiling(
        tiler.GetTiling(
            tiling)
    );


    /*
     * 回读校验（不信任"tiler 一定照办"这个假设）。
     *   * 上界：kernel 侧的 UB 缓冲与 GM 槽位都按 MAX_* 分配，回读值必须不超；
     *   * baseM >= min(splitM, m)：否则 singleCoreM 会被切成多个 mBlocks，
     *     而本版把同一行块的 N 分片**原地**原子归并进一个 [baseM, baseN] 缓冲，
     *     这个等式要求 mBlocks == 1；
     *   * baseN 8 对齐：WholeReduceMax 的行距按 datablock(32B) 计。
     * 任一不满足直接 Fail —— 宁可本地不跑，也不带着错假设上板。
     */
    if (
        tiling.baseM <= 0 ||
        tiling.baseN <= 0 ||
        static_cast<uint32_t>(
            tiling.baseM) > MAX_BASE_M ||
        static_cast<uint32_t>(
            tiling.baseN) > MAX_TILE_N ||
        (
            static_cast<uint32_t>(
                tiling.baseN) &
            7U) != 0U ||
        static_cast<uint32_t>(
            tiling.baseM) <
            std::min<uint32_t>(
                splitM,
                shape.m)
    ) {

        Fail();
    }


    // ------------------------------------------------------------------------
    // Workspace
    // ------------------------------------------------------------------------

    const size_t systemBytes =

        std::max<size_t>(

            32,

            static_cast<size_t>(

                platform
                    ->GetLibApiWorkSpaceSize()
            )
        );


    void *systemDevice =
        nullptr;


    CheckAcl(
        aclrtMalloc(

            &systemDevice,

            systemBytes,

            ACL_MEM_MALLOC_HUGE_FIRST)
    );


    CheckAcl(
        aclrtMemset(

            systemDevice,

            systemBytes,

            0,

            systemBytes)
    );


    CheckAcl(
        aclrtMemset(

            y,

            static_cast<size_t>(
                shape.b) *
                sizeof(float),

            0,

            static_cast<size_t>(
                shape.b) *
                sizeof(float))
    );


    /*
     * 每 execution unit 3 个槽位（AIV 的 [0,2*blocks) 两个 + AIC 后移的一个），
     * 每槽位再分两半（SLOT_ELEMS）：前半 = 整分片原子归并缓冲，后半 = N 尾块缓冲。
     * 取值必须与 kernel 侧的 SLOT_ELEMS 公式一致。
     */
    const size_t cBytes =

        static_cast<size_t>(
            blocks) *
        3U *
        2U *
        MAX_BASE_M *
        MAX_TILE_N *
        sizeof(float);


    void *cDevice =
        nullptr;


    CheckAcl(
        aclrtMalloc(

            &cDevice,

            cBytes,

            ACL_MEM_MALLOC_HUGE_FIRST)
    );


    // ------------------------------------------------------------------------
    // Cube + Vector MaxSim + Sum fused in one launch
    // ------------------------------------------------------------------------

    if (
        inputDtype == 1
    ) {

        LaunchMatmulPath<half>(

            x1,

            x2,

            y,

            (GM_ADDR)systemDevice,

            (GM_ADDR)cDevice,

            tiling,

            shape,

            blocks,

            stream,

            transposeX1,

            transposeX2
        );
    }

    else {

        LaunchMatmulPath<
            bfloat16_t>(

            x1,

            x2,

            y,

            (GM_ADDR)systemDevice,

            (GM_ADDR)cDevice,

            tiling,

            shape,

            blocks,

            stream,

            transposeX1,

            transposeX2
        );
    }


    /*
     * workspace 在本函数内部申请，
     * 所以释放前必须确保该 stream
     * 已经完成访问。
     */
    CheckAcl(
        aclrtSynchronizeStreamWithTimeout(
            stream,
            3000)
    );


    CheckAcl(
        aclrtFree(
            cDevice)
    );


    CheckAcl(
        aclrtFree(
            systemDevice)
    );
}

} // namespace bmmms


// ============================================================================
// Contest ABI
// ============================================================================

extern "C" void run_kernel(
    GM_ADDR x1,
    const TensorGroupInfo &info_x1,

    GM_ADDR x2,
    const TensorGroupInfo &info_x2,

    GM_ADDR y,
    const TensorGroupInfo &info_y,

    int64_t availableCoreNum,

    aclrtStream stream,

    bool transposeX1,

    bool transposeX2)
{
    bmmms::Launch(

        x1,
        info_x1,

        x2,
        info_x2,

        y,
        info_y,

        availableCoreNum,

        stream,

        transposeX1,

        transposeX2
    );
}


// ============================================================================
// VERIFY —— 上板必查（本机无 CANN / NPU，以下都**没有**本地证据）
//
// 1) 【最高优先级】Fixpipe 的 AtomicMax 是否真的生效：
//    GetTensorC(cAcc, enAtomic=2, enSequentialWrite=true) 这一条组合，
//    真机上没有任何直接证据 —— 文档只分别写了 enAtomic（0/1/2/3）与
//    enSequentialWrite 两个参数（`GetTensorC.md:100`）。
//    失败特征很好认：**所有 case 的结果偏小**（只剩最后一个 N 分片的贡献）。
//    若确实不生效，退路是 teammate-latest.asc（15/15 基线），或把它改成
//    "每个分片落独立槽位、AIV 依次读"（= 基线行为，GM 次数回到 2×分片数）。
// 2) enAtomic 残留：本版在每个行块的尾片前显式 SetAtomicNone()，并且
//    y 的写出走 DataCopyPad（普通写）。上板确认 y 不被原子化
//    （若 y 变成 max(旧值, 新值) 之类，说明原子模式残留）。
// 3) WholeReduceMax 的行距/顺序参数：mask=64、repeat=validM、dstRepStride=1、
//    srcBlkStride=1、srcRepStride=baseN/8、ORDER_ONLY_VALUE。
//    失败特征：行最大值取到了别的行的数据（各 case 结果系统性偏大或错位）。
//    对照：基线用的是"每行一次 ReduceMax"，语义等价、参数面更小。
// 4) tiler 回读：host 侧已 Fail 掉 baseM/baseN 越界与 baseM < min(splitM,m)，
//    上板确认没有触发 Fail（触发即本地不跑，不会带错假设）。
//    同时**打印回读的 baseM/baseN/dbL0C**：
//      * baseN == 256 且 dbL0C == 1 ⇒ 分片 128×256×4 = 131072 = L0C 满存，本版目标达成；
//      * 若 baseN 退到 128（tiler 拒绝 256），说明 L0A/L0B/L1 放不下对应的 baseK，
//        此时 L0C 只用 64KB —— 正确性不变，只是"满存"只达成一半，
//        下一步该调 baseK/SetBufferSpace 而不是继续放大 baseN。
// 5) UB 预算：本版 UB = cUb(128×256×4 = 131072) + 4×128×4 = 133120 B / 192KB。
//    若上板 InitBuffer 报 UB 不足，把 MAX_TILE_N 降到 192 或 128
//    （kernel 用回读值工作，改常量即可，不需要动逻辑）。
// 6) dbL0C == 1 意味着 Mmad 与 Fixpipe 不能重叠（L0C 只有一份）。本版 AIV 每行块
//    只读一次，串行代价主要在 AIC 侧；若实测"分片数变少了但总时间没变"，
//    下一档是把 baseN 降到 128（dbL0C=2，两种流水重叠）再比一次。
// 7) 原子模式是否残留到 y 的写出（本版在尾片前显式 SetAtomicNone()）。
// 8) 确定性：AtomicMax 与顺序无关、且 max 是精确操作 ⇒ 结果应逐位可复现；
//    题面要求"多次执行结果一致"。若发现同样的输入两次结果不同，必须回到基线。
// 9) 精度：本版不改数值路径（累加顺序与基线一致：先跨 N 分片取 max，再按行升序求和），
//    所以精度结论沿用 PRECISION-REPORT.md（余量约 1000×）。
// ============================================================================