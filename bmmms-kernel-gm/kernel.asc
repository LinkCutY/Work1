// ============================================================================
// kernel.asc — BatchMatmulMaxSum @ 910C (Atlas A3 / __NPU_ARCH__=2201)
//
// 基线 = 队友 push 的 origin/main（f5b3995，kernel.asc blob 3e96fd39，真机 15/15）。
// 本版继续只做「少穿 GM」，数学语义、任务划分、输出写回方式不变。
//
// 三条杠杆（完整推导与文档出处见下方 MatmulMaxKernel 前的长注释）：
//   [1] **一次 `IterateAll` 算完一个行块**（同步语义，`IterateAll.md:20-70`）：
//       AIV↔AIC 的握手从"每个 N 分片一次"（m=4096/n=4096 时每 batch 1024 次）
//       降到"每个行块一次"（32 次）—— 这是本版唯一的关键差别，也是它快的原因。
//       上一版虽然把分片放大到 128×128，但握手仍是每片一次，所以快不了多少。
//   [2] 连续写把同一行块的 N 个分片按 [validM, baseN] 顺序紧挨着铺在 GM staging 里，
//       AIV 一次 DataCopyPad 读回 READ_TILES=2 片（128KB），把 UB 一次铺满。
//   [3] 归约 = 两级 WholeReduceMax（64 列一组 → 每行的组折成 1）+ 跨分片 Max：
//       全程无原子、与分片顺序无关；N 尾块走基线已实测的标量逐行读法。
//   tiler 拒绝某档就逐档退让（baseN: 128→…→8、baseM: 128→16），
//   最后一档 = 基线（真机 15/15）用的 (16, splitN)，一定拿得到 tiling。
//
// GM 往返账（单 batch、每行块，baseM=baseN=128）：Fixpipe 写 n/baseN 片（每片 64KB）、
//   AIV 读 ceil((n/baseN)/2) 次（每次 128KB）+ 尾块一次；**同步只有 1 次**。
// 单核 M = validM ≤ baseM ⇒ 一个行块内只有 1 个 M 块，分片产出顺序对本 kernel 无影响。
//
// 【真机反馈：第 8 个点 RE（status 134）】日志里崩的是某个大 shape 的
//   MatmulMaxKernel<bf16,1,1>（同一个模板前面 Block Dim 4 的用例都正常，崩的那次 Block Dim 9）。
//   134 = host abort。本版把 v5 引入的两条"随 shape 变化的自伤路径"堵上：
//     * staging 总占用按 64MB 预算收缩 blocks，并且 **aclrtMalloc 失败时继续砍 blocks 重试**
//       （v5 按 blocks 全额申请，n 大、b 大时会要几百 MB，malloc 失败即 abort）；
//     * staging 每块多留**一个分片**的余量（baseM*(n+baseN)），并且非活动 worker 的
//       槽位下标夹到 0 —— 保证无论连续写的步进按有效尺寸还是补齐尺寸都不会越界。
//
// ⚠ 本机没有 CANN / NPU：本文件**未编译、未上板**。上板必查清单见文件末尾 VERIFY。
//
// 【判题硬规则（真机反馈原文）】
//   "Profiling rule violated: each iteration must launch exactly 1 kernel.
//    Expected 75 launches, got 110."
//   一次迭代只能启动 1 个 kernel；**而且任何 abort（host Fail() / status 134）都会被
//   平台 <ReplayOnce> 重放，每次重放多算一次 launch**（110 = 75 + 7×5）。
//   本版保留上一版的修复：所有"我方主动 Fail"的路径都改成"退让到基线兜底档"，
//   回读校验只留 kernel 侧真正依赖的必要条件。启动点只有两处（小路径 / 主路径），
//   互斥分支，任一时刻只走一个 —— 本地用 tools/launch_check.py 守这条规则。
// ============================================================================

#include <cstdint>
#include <cstdlib>
#include <algorithm>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"

namespace bmmms {

using namespace AscendC;
using CubeTiling = AscendC::tiling::TCubeTiling;

/*
 * 分片上限。L0C = 128KB、C 为 float ⇒ baseM*baseN*4 ≤ 131072。
 * 取 128 x 128 = 16384（64KB/片 ⇒ dbL0C = 2，Mmad 与 Fixpipe 可重叠）。
 *
 * 为什么是"方阵"：AIC 从 GM 取操作数的量是
 *     (n/baseN)*m*k*2  +  (m/baseM)*n*k*2
 * （每个 C 分片都要把 A 的 baseM×k、B 的 k×baseN 面板各流过一遍 L1），
 * 在 baseM*baseN 受 L0C 限制时，这个和由 AM-GM 在 baseM ≈ baseN 处最小。
 * 128x128 同时让 L0C 留出双缓冲，所以取它；tiler 拒绝时 Launch 会逐档退让。
 */
static constexpr uint32_t MAX_BASE_M = 128;

/*
 * baseN 上限取 **256** —— 与队友那版真机 15/15 的基线同一个口径。
 * 教训：我中间几版把它压到 128，等于"比基线更严"；一旦 tiler 对某些 shape
 * 只肯给更大的 baseN，就会走到 host 的 Fail() → abort → 平台 ReplayOnce 重放
 * → 多算一次 kernel launch → 直接违反 "each iteration must launch exactly 1 kernel"
 * （真机原文 Expected 75, got 110，差值 35 = 7 个 case × 5 次迭代）。
 * 请求阶梯仍然**优先**方阵 128（L0C 64KB/片、dbL0C=2），只在方阵带全败时才用大 baseN。
 */
static constexpr uint32_t MAX_TILE_N = 256;

/*
 * 每次 DataCopyPad 读回的分片数。取 1：UB 必须容得下 baseN 到 256 的单个分片
 * （128*256*4 = 128KB），再乘 2 就超 192KB 了。读次数多一次没关系 ——
 * 本版省的是**同步次数**（每行块 1 次），不是读次数。
 */
static constexpr uint32_t READ_TILES = 1;
static constexpr uint64_t SMALL_MAC_LIMIT = 32768;
static constexpr float NEG_INF = -3.402823466e38f;

struct Shape {
    uint32_t b;
    uint32_t m;
    uint32_t n;
    uint32_t k;
};


// ============================================================================
// Device helpers
// ============================================================================

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

__aicore__ inline float AbsF32(float x)
{
    return x < 0.0f ? -x : x;
}

__aicore__ inline float Decode(half x)
{
    return static_cast<float>(x);
}

__aicore__ inline float Decode(bfloat16_t x)
{
    return AscendC::ToFloat(x);
}

__aicore__ inline void AddCompensated(
    float value,
    float &sum,
    float &correction)
{
    const float next = sum + value;

    if (AbsF32(sum) >= AbsF32(value)) {
        correction += (sum - next) + value;
    } else {
        correction += (value - next) + sum;
    }

    sum = next;
}

template <HardEvent E>
__aicore__ inline void Fence(TPipe &pipe)
{
    const event_t event =
        static_cast<event_t>(
            pipe.FetchEventID(E));

    SetFlag<E>(event);
    WaitFlag<E>(event);
}


// ============================================================================
// Small-input path
// ============================================================================

template <typename InputT>
__global__ __aicore__ void SmallKernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    Shape shape,
    bool transposeX1,
    bool transposeX2)
{
    if (GetBlockIdx() != 0) {
        return;
    }

    TPipe pipe;

    TBuf<TPosition::VECCALC> outBuf;

    pipe.InitBuffer(
        outBuf,
        64 * sizeof(float));

    LocalTensor<float> outLocal =
        outBuf.Get<float>();


    GlobalTensor<InputT> a;
    GlobalTensor<InputT> b;
    GlobalTensor<float> out;


    a.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x1),
        static_cast<uint64_t>(shape.b) *
            shape.m *
            shape.k);


    b.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x2),
        static_cast<uint64_t>(shape.b) *
            shape.n *
            shape.k);


    out.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(y),
        shape.b);


    for (uint32_t batch = 0;
         batch < shape.b;
         ++batch) {

        const uint64_t aBase =
            static_cast<uint64_t>(batch) *
            shape.m *
            shape.k;


        const uint64_t bBase =
            static_cast<uint64_t>(batch) *
            shape.n *
            shape.k;


        float total = 0.0f;
        float totalCorr = 0.0f;


        for (uint32_t row = 0;
             row < shape.m;
             ++row) {

            float best = 0.0f;


            for (uint32_t col = 0;
                 col < shape.n;
                 ++col) {

                float dot = 0.0f;
                float dotCorr = 0.0f;


                for (uint32_t kk = 0;
                     kk < shape.k;
                     ++kk) {

                    const uint64_t aOffset =
                        aBase +
                        (
                            transposeX1
                                ?
                                static_cast<uint64_t>(kk) *
                                        shape.m +
                                    row
                                :
                                static_cast<uint64_t>(row) *
                                        shape.k +
                                    kk
                        );


                    const uint64_t bOffset =
                        bBase +
                        (
                            transposeX2
                                ?
                                static_cast<uint64_t>(col) *
                                        shape.k +
                                    kk
                                :
                                static_cast<uint64_t>(kk) *
                                        shape.n +
                                    col
                        );


                    const float product =
                        Decode(
                            a.GetValue(aOffset)
                        )
                        *
                        Decode(
                            b.GetValue(bOffset)
                        );


                    AddCompensated(
                        product,
                        dot,
                        dotCorr);
                }


                const float score =
                    dot + dotCorr;


                if (col == 0 ||
                    score > best) {

                    best = score;
                }
            }


            AddCompensated(
                best,
                total,
                totalCorr);
        }


        outLocal.SetValue(
            batch,
            total + totalCorr);
    }


    Fence<HardEvent::S_MTE3>(
        pipe);


    DataCopyExtParams copyOut;

    copyOut.blockCount = 1;

    copyOut.blockLen =
        shape.b *
        sizeof(float);

    copyOut.srcStride = 0;
    copyOut.dstStride = 0;
    copyOut.rsv = 0;


    DataCopyPad(
        out,
        outLocal,
        copyOut);


    Fence<HardEvent::MTE3_S>(
        pipe);


    PipeBarrier<PIPE_ALL>();
}


// ============================================================================
// Cube Matmul + Vector MaxSim
// ============================================================================
//
// 本版目标：把 AIV 与 AIC 之间的**同步次数**和 GM 往返都压到平台允许的下限。
//
// 平台事实（`910D_knowledge_extra/220x到351x架构变更.md:120-165`）：L0C→UB 直通是
// **351x 才新增**的通路；本题实测架构是 220x（DAV_2201），没有它 —— 每块 C 分片
// 只能由 Fixpipe 写一次 GM、再由 AIV 读回来，这条路径绕不开。
//
// 那剩下的杠杆就是**别一片一片地握手**：
//
//   [1] `mm.IterateAll(cStage, 0, /*enSequentialWrite=*/true)`
//       —— 文档（`IterateAll.md:20-70`）："调用一次IterateAll，会计算出
//       singleCoreM * singleCoreN大小的C矩阵"，**默认同步**（`sync = true`，
//       "需要同步等待IterateAll执行结束"），A2/A3 支持，且示例就是
//       `REGIST_MATMUL_OBJ + SetTensorA/B + IterateAll(gm_c)` —— 与本文件同构。
//       ⇒ 一个行块只**握手 1 次**。旧写法 `while (mm.Iterate()) { GetTensorC(...) }`
//         是每个 N 分片握手一次：m=4096/n=4096 时 每 batch 1024 次 → 现在 32 次。
//         这是本版相对"每片 GetTensorC"版本的**唯一关键差别**，也是它快的原因。
//
//   [2] 连续写把同一行块的 N 个分片**顺序紧挨着**铺在 staging 里（每片 [validM, baseN]，
//       尾片 [validM, tailN]），于是 AIV 可以用**大块搬运**读回来：
//       一次 `DataCopyPad` 读 READ_TILES 片（2×128×128×4 = 128KB，把 UB 铺满），
//       而不是每片一次 64KB。读回来后按分片做两级 WholeReduceMax（见下）。
//
//   [3] 归约改成"两级 + 按行合并"，全程无原子、与分片顺序无关：
//       第一级：每 64 列一组求最大值，`dstRepStride = 8` 把结果按 32B 对齐排布；
//       第二级：把每行的 baseN/64 个组折成 1 个（`srcRepStride = baseN/64` 个 datablock）；
//       然后把每个分片的行最大值 Max 进行最大值向量（只有跨 N 的 max，与顺序无关）。
//       ⇒ 不再需要 AtomicMax（那是上一版的唯一未验证组合），也不需要按分片下标路由。
//
// 为什么正确性不受影响：
//   * 行最大值 = max over N：分片之间只做 Max，与产出顺序无关。
//   * N 尾块（n % baseN != 0）单独读：连续写在尾片按 validN 紧凑打包，行距是 validN、
//     行首不再 32B 对齐 —— 沿用 15/15 版本验证过的标量逐行读法（123b2b8 的结论）。
//   * 行和只在 row < validM 上做，最后每 batch 只写一个 float 到 y[batch]。
// ============================================================================

template <
    typename InputT,
    bool TRANSPOSE_A,
    bool TRANSPOSE_B>
__global__ __aicore__ void MatmulMaxKernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    __kfc_workspace__ GM_ADDR systemWorkspace,
    GM_ADDR cWorkspace,
    CubeTiling tiling,
    Shape shape,
    uint32_t workerCount)
{
    TPipe pipe;


    using AType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            InputT,
            TRANSPOSE_A>;


    using BType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            InputT,
            TRANSPOSE_B>;


    using CType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            float>;


    Matmul<
        AType,
        BType,
        CType> mm;


    REGIST_MATMUL_OBJ(
        &pipe,
        GetSysWorkSpacePtr(),
        mm,
        &tiling);


    /*
     * 编译期上限：UB 缓冲全部按 MAX_* 分配，实际几何取自 tiling 回读值
     * （host 侧已校验回读值不超上限）。
     */
    /* 一次读回的分片数 × 每片行数 = 一级归约要覆盖的行数 */
    static constexpr uint32_t
        MAX_ROWS =
            READ_TILES *
            MAX_BASE_M;

    /* 每行最多切成几个"列组"：完整 64 列组 + 1 个余列组 */
    static constexpr uint32_t
        GROUP_MAX =
            (MAX_TILE_N /
             64U) +
            1U;


    TBuf<TPosition::VECCALC> tileBuf;
    TBuf<TPosition::VECCALC> groupBuf;
    TBuf<TPosition::VECCALC> rowMaxBuf;
    TBuf<TPosition::VECCALC> tailMaxBuf;
    TBuf<TPosition::VECCALC> rowOutBuf;


    /* 一次读回 READ_TILES 片：2 × 128 × 128 × 4B = 128KB，把 UB 铺满 */
    pipe.InitBuffer(
        tileBuf,
        READ_TILES *
            MAX_BASE_M *
            MAX_TILE_N *
            sizeof(float));


    /* 第一级输出：每个列组一块连续区间（GROUP_MAX 组 × MAX_ROWS 行） */
    pipe.InitBuffer(
        groupBuf,

        GROUP_MAX *
            MAX_ROWS *
            sizeof(float));


    pipe.InitBuffer(
        rowMaxBuf,
        MAX_BASE_M *
            sizeof(float));


    pipe.InitBuffer(
        tailMaxBuf,
        MAX_BASE_M *
            sizeof(float));


    pipe.InitBuffer(
        rowOutBuf,
        MAX_BASE_M *
            sizeof(float));


    LocalTensor<float>
        cUb =
            tileBuf.Get<float>();


    LocalTensor<float>
        groupMax =
            groupBuf.Get<float>();


    LocalTensor<float>
        rowMaxVec =
            rowMaxBuf.Get<float>();


    LocalTensor<float>
        tailMaxVec =
            tailMaxBuf.Get<float>();


    LocalTensor<float>
        rowOut =
            rowOutBuf.Get<float>();


    /*
     * tiling 回读值。host 侧已校验：baseM ≤ MAX_BASE_M、baseN ≤ MAX_TILE_N、
     * baseN % 8 == 0（行距按 datablock 计）。
     *
     * singleCoreM 恒 = validM ≤ baseM ⇒ 一个行块内只有 1 个 M 块，产出顺序对本
     * kernel 完全无所谓（片之间只做 Max）。
     */
    const uint32_t baseM =
        static_cast<uint32_t>(
            tiling.baseM);


    const uint32_t baseN =
        static_cast<uint32_t>(
            tiling.baseN);


    const uint32_t
        nFullTiles =
            shape.n /
            baseN;


    const uint32_t
        tailN =
            shape.n -
            nFullTiles *
                baseN;


    /*
     * 归约几何：每行先按 64 列切"完整组"，剩下的（baseN%64，8 的倍数）算一个"余列组"。
     * 每组在做完第一级后占 PASS_STRIDE 个 float（= 32B，天然对齐），
     * 于是每行在 passUb 里占 groupCount*PASS_STRIDE 个 float。
     */
    const uint32_t
        fullGroups =
            baseN /
            64U;


    const uint32_t
        remCols =
            baseN -
            fullGroups *
                64U;


    const uint32_t
        groupCount =
            fullGroups +
            (
                remCols > 0U
                    ? 1U
                    : 0U
            );


    /* 行距（datablock = 32B = 8 个 fp32） */
    const uint32_t
        rowPitchBlocks =
            baseN >>
            3;


    GlobalTensor<InputT> a;
    GlobalTensor<InputT> b;
    GlobalTensor<float> out;


    a.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x1),

        static_cast<uint64_t>(
            shape.b) *
            shape.m *
            shape.k);


    b.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x2),

        static_cast<uint64_t>(
            shape.b) *
            shape.n *
            shape.k);


    out.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(y),

        static_cast<uint64_t>(
            shape.b));


    const uint32_t worker =
        static_cast<uint32_t>(
            GetBlockIdx());


    /*
     * task = (batch)：全 worker 里只有 id < b 的会真的读写 cStage（其余 task 循环不进），
     * 所以槽位数 = min(b, 2*blocks)，槽位下标就用 worker 本身（host 侧同公式申请）。
     */
    const uint32_t workers =
        workerCount;


    /*
     * staging：每个 worker 一块，够放"一个行块的整张 C"。
     *   * 元素数 = baseM * (n + baseN)：多留**一个分片**的余量。连续写把
     *     ceil(n/baseN) 个分片铺开，不论步进按"有效尺寸 [validM, baseN]"还是按
     *     "补齐尺寸 [baseM, baseN]"算，尾部都落在这块缓冲里 —— 上板时报"只有
     *     m % baseM != 0 的 case 崩"就是步进被补齐了，这样至少不会越界。
     *   * 槽位数 = min(b, workers)（只有 id < b 的 worker 会真正读写），所以**非活动
     *     worker 一律夹到 0 号槽**，避免它们算出越界地址（它们不写，但地址要合法）。
     *   * host 侧用完全相同的公式申请（见 Launch 里的 stageElems）。
     */
    const uint32_t stageSlots =
        MinU32(
            shape.b,
            workers);


    uint32_t cSlot =
        worker;

    if (cSlot >= stageSlots) {

        cSlot = 0;
    }


    GlobalTensor<float> cStage;


    cStage.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(cWorkspace) +
            static_cast<uint64_t>(
                cSlot) *
                static_cast<uint64_t>(
                    baseM) *
                (
                    shape.n +
                    baseN
                ),

        static_cast<uint64_t>(
            baseM) *
            (
                shape.n +
                baseN
            ));


    /*
     * 一个 task = 一个 batch：属主 AIV 走完它的所有行块，行和累在寄存器里，
     * 最后只写一个 float 到 y[batch]。无原子、无跨 worker 累加、无第二阶段。
     */
    for (uint32_t task = worker;
         task < shape.b;
         task += workers) {

        const uint32_t batch =
            task;


        float batchSum = 0.0f;


        for (uint32_t rowStart = 0;
             rowStart < shape.m;
             rowStart += baseM) {

        const uint32_t validM =
            MinU32(
                baseM,
                shape.m -
                    rowStart);


        const uint64_t aOffset =
            static_cast<uint64_t>(
                batch) *
                shape.m *
                shape.k
            +
            (
                TRANSPOSE_A
                    ?
                    static_cast<uint64_t>(
                        rowStart)
                    :
                    static_cast<uint64_t>(
                        rowStart) *
                        shape.k
            );


        const uint64_t bOffset =
            static_cast<uint64_t>(
                batch) *
                shape.n *
                shape.k;


        Duplicate(
            rowMaxVec,
            NEG_INF,
            static_cast<int32_t>(
                MAX_BASE_M));


        mm.SetOrgShape(
            shape.m,
            shape.n,
            shape.k);


        mm.SetSingleShape(
            validM,
            shape.n,
            shape.k);


        mm.SetTensorA(
            a[aOffset],
            TRANSPOSE_A);


        mm.SetTensorB(
            b[bOffset],
            TRANSPOSE_B);


        /*
         * 【杠杆 1】一个行块只同步一次：整张 [validM, n] 的 C 由这一次调用算完并搬出。
         * 连续写把第 t 个 N 分片放在 cStage[t*validM*baseN]（尾片 [validM, tailN]）。
         */
        mm.IterateAll(
            cStage,
            0U,
            true);


        /*
         * 【杠杆 2】大块读回 + 【杠杆 3】两级归约，一次处理 READ_TILES 个分片。
         */
        uint32_t tileIdx = 0;


        while (tileIdx < nFullTiles) {

            const uint32_t tiles =
                MinU32(
                    READ_TILES,
                    nFullTiles -
                        tileIdx);


            const uint32_t rows =
                tiles *
                validM;


            Fence<
                HardEvent::V_MTE2>(
                    pipe);


            DataCopyExtParams
                copyTiles;

            copyTiles.blockCount =
                static_cast<uint16_t>(
                    rows);

            copyTiles.blockLen =
                baseN *
                sizeof(float);

            copyTiles.srcStride = 0;
            copyTiles.dstStride = 0;
            copyTiles.rsv = 0;


            DataCopyPadExtParams<float>
                padTiles;


            DataCopyPad(
                cUb,
                cStage[
                    tileIdx *
                    validM *
                    baseN
                ],
                copyTiles,
                padTiles);


            Fence<
                HardEvent::MTE2_V>(
                    pipe);


            /*
             * 第一级：逐个"列组"归约 —— 第 g 组固定取每行的 [colBase, colBase+columns) 列，
             * 行距用 srcRepStride = baseN/8 个 datablock（与 baseN 是不是 64 的倍数无关），
             * 结果**连续**落在 groupMax[g*MAX_ROWS + r]（dstRepStride = 1）。
             * 单次 repeat 上限 255，故按行分批：超过就多调几次，接着往后写。
             */
            for (uint32_t g = 0;
                 g < groupCount;
                 ++g) {

                const uint32_t columns =
                    (
                        g <
                        fullGroups
                    )
                        ? 64U
                        : remCols;


                const uint32_t colBase =
                    (
                        g <
                        fullGroups
                    )
                        ? g *
                            64U
                        : fullGroups *
                            64U;


                for (uint32_t r = 0;
                     r < rows;
                     r += 255U) {

                    WholeReduceMax(
                        groupMax[
                            g *
                                MAX_ROWS +
                            r
                        ],
                        cUb[
                            r *
                                baseN +
                            colBase
                        ],
                        static_cast<int32_t>(
                            columns),
                        static_cast<int32_t>(
                            MinU32(
                                255U,
                                rows -
                                    r)),
                        1,
                        1,
                        static_cast<int32_t>(
                            rowPitchBlocks),
                        ReduceOrder::
                            ORDER_ONLY_VALUE);
                }
            }


            /*
             * 第二级：每个列组的结果都连续排着，直接按元素 Max 折成每行的最大值
             * （组之间只有 Max，可交换可结合 ⇒ 与顺序无关）。
             */
            for (uint32_t g = 1;
                 g < groupCount;
                 ++g) {

                Max(
                    groupMax,
                    groupMax,
                    groupMax[
                        g *
                        MAX_ROWS
                    ],
                    static_cast<int32_t>(
                        rows));
            }


            /* 分片之间也只做 Max（跨 N 取最大） */
            for (uint32_t j = 0;
                 j < tiles;
                 ++j) {

                Max(
                    rowMaxVec,
                    rowMaxVec,
                    groupMax[
                        j *
                        validM
                    ],
                    static_cast<int32_t>(
                        validM));
            }


            tileIdx +=
                tiles;
        }


        /*
         * N 尾块：连续写在尾片按 validN 紧凑打包，所以行距是 tailN，
         * 行首不再 32B 对齐 —— 沿用 15/15 版本验证过的标量逐行读法。
         */
        if (tailN > 0U) {

            Fence<
                HardEvent::V_MTE2>(
                    pipe);


            DataCopyExtParams
                copyTail;

            copyTail.blockCount = 1;

            copyTail.blockLen =
                validM *
                tailN *
                sizeof(float);

            copyTail.srcStride = 0;
            copyTail.dstStride = 0;
            copyTail.rsv = 0;


            DataCopyPadExtParams<float>
                padTail;


            DataCopyPad(
                cUb,
                cStage[
                    nFullTiles *
                    validM *
                    baseN
                ],
                copyTail,
                padTail);


            Fence<
                HardEvent::MTE2_V>(
                    pipe);


            Duplicate(
                tailMaxVec,
                NEG_INF,
                static_cast<int32_t>(
                    MAX_BASE_M));


            Fence<
                HardEvent::V_S>(
                    pipe);


            for (uint32_t row = 0;
                 row < validM;
                 ++row) {

                float rowBest =
                    NEG_INF;

                const uint32_t srcBase =
                    row *
                    tailN;

                for (uint32_t col = 0;
                     col < tailN;
                     ++col) {

                    const float v =
                        cUb.GetValue(
                            srcBase + col);

                    if (v > rowBest) {
                        rowBest = v;
                    }
                }


                tailMaxVec.SetValue(
                    row,
                    rowBest);
            }


            Fence<
                HardEvent::S_V>(
                    pipe);


            Max(
                rowMaxVec,
                rowMaxVec,
                tailMaxVec,
                static_cast<int32_t>(
                    validM));
        }


        Fence<
            HardEvent::V_S>(
                pipe);


        float tileSum = 0.0f;


        for (uint32_t row = 0;
             row < validM;
             ++row) {

            tileSum +=
                rowMaxVec
                    .GetValue(row);
        }


        batchSum += tileSum;


        Fence<
            HardEvent::S_V>(
                pipe);
        }


        if
            ASCEND_IS_AIV
        {

            rowOut.SetValue(
                0,
                batchSum);


            Fence<
                HardEvent::S_MTE3>(
                    pipe);


            DataCopyExtParams
                copyOut;

            copyOut.blockCount = 1;

            copyOut.blockLen =
                sizeof(float);

            copyOut.srcStride = 0;

            copyOut.dstStride = 0;

            copyOut.rsv = 0;


            DataCopyPad(
                out[
                    batch
                ],
                rowOut,
                copyOut);


            Fence<
                HardEvent::MTE3_S>(
                    pipe);
        }
    }


    mm.End();


    PipeBarrier<PIPE_ALL>();
}


// ============================================================================
// Host helpers
// ============================================================================

[[noreturn]]
inline void Fail()
{
    std::abort();
}


inline void CheckAcl(
    aclError result)
{
    if (result !=
        ACL_SUCCESS) {

        std::abort();
    }
}


inline void CheckTiling(
    int64_t result)
{
    if (result < 0) {
        std::abort();
    }
}


inline const TensorInfo &
SingleTensor(
    const TensorGroupInfo &info)
{
    if (
        info.numTensors != 1 ||
        info.tensors == nullptr ||
        info.tensors[0].shape ==
            nullptr
    ) {

        Fail();
    }


    return
        info.tensors[0];
}


// ============================================================================
// Metadata parsing
// ============================================================================

inline Shape ParseShape(
    const TensorGroupInfo &infoX1,
    const TensorGroupInfo &infoX2,
    const TensorGroupInfo &infoY,
    bool transposeX1,
    bool transposeX2)
{
    const TensorInfo &a =
        SingleTensor(infoX1);


    const TensorInfo &b =
        SingleTensor(infoX2);


    const TensorInfo &out =
        SingleTensor(infoY);


    if (
        a.numDims != 3 ||
        b.numDims != 3 ||
        out.numDims != 1
    ) {
        Fail();
    }


    if (
        a.dtype != b.dtype ||
        (
            a.dtype != 1 &&
            a.dtype != 2
        ) ||
        out.dtype != 0
    ) {
        Fail();
    }


    const int64_t B =
        a.shape[0];


    const int64_t M =
        a.shape[
            transposeX1
                ? 2
                : 1
        ];


    const int64_t K1 =
        a.shape[
            transposeX1
                ? 1
                : 2
        ];


    const int64_t K2 =
        b.shape[
            transposeX2
                ? 2
                : 1
        ];


    const int64_t N =
        b.shape[
            transposeX2
                ? 1
                : 2
        ];


    if (
        B <= 0 ||
        M <= 0 ||
        N <= 0 ||
        K1 <= 0 ||
        K2 <= 0 ||
        b.shape[0] != B ||
        K1 != K2 ||
        out.shape[0] != B
    ) {

        Fail();
    }


    Shape shape;


    shape.b =
        static_cast<uint32_t>(
            B);


    shape.m =
        static_cast<uint32_t>(
            M);


    shape.n =
        static_cast<uint32_t>(
            N);


    shape.k =
        static_cast<uint32_t>(
            K1);


    return shape;
}


// ============================================================================
// Four storage layouts
// ============================================================================

template <typename InputT>
inline void LaunchMatmulPath(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    GM_ADDR workspace,
    GM_ADDR cWorkspace,
    const CubeTiling &tiling,
    Shape shape,
    uint32_t blocks,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    if (
        !transposeX1 &&
        !transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            false,
            false>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else if (
        !transposeX1 &&
        transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            false,
            true>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else if (
        transposeX1 &&
        !transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            true,
            false>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else {

        MatmulMaxKernel<
            InputT,
            true,
            true>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }
}


// ============================================================================
// Launch
// ============================================================================

inline void Launch(
    GM_ADDR x1,
    const TensorGroupInfo &infoX1,
    GM_ADDR x2,
    const TensorGroupInfo &infoX2,
    GM_ADDR y,
    const TensorGroupInfo &infoY,
    int64_t availableCoreNum,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    const Shape shape =
        ParseShape(
            infoX1,
            infoX2,
            infoY,
            transposeX1,
            transposeX2);


    const int32_t inputDtype =
        infoX1
            .tensors[0]
            .dtype;


    const uint64_t macs =
        static_cast<uint64_t>(
            shape.b)
        *
        shape.m
        *
        shape.n
        *
        shape.k;


    // ------------------------------------------------------------------------
    // Tiny shape path
    // ------------------------------------------------------------------------

    if (
        macs <=
        SMALL_MAC_LIMIT
    ) {

        if (
            inputDtype == 1
        ) {

            SmallKernel<half>
                <<<1,
                   nullptr,
                   stream>>>(
                    x1,
                    x2,
                    y,
                    shape,
                    transposeX1,
                    transposeX2);
        }

        else {

            SmallKernel<bfloat16_t>
                <<<1,
                   nullptr,
                   stream>>>(
                    x1,
                    x2,
                    y,
                    shape,
                    transposeX1,
                    transposeX2);
        }


        return;
    }


    // ------------------------------------------------------------------------
    // Matmul path
    // ------------------------------------------------------------------------

    if (
        availableCoreNum <= 0
    ) {

        Fail();
    }


    platform_ascendc::
        PlatformAscendC *platform =

        platform_ascendc::
            PlatformAscendCManager::
                GetInstance();


    if (
        platform ==
        nullptr
    ) {

        Fail();
    }


    /*
     * baseM/baseN 只按 16 对齐后申请（`SetFixSplit.md` 要求 baseM <= ceil16(singleM)），
     * 实际值一律以 tiler 回读为准，回读值同时决定 UB 缓冲与 GM 槽位的几何。
     */
    const uint32_t splitM =

        std::min<uint32_t>(

            MAX_BASE_M,

            (
                (
                    shape.m +
                    15U
                ) /
                16U
            ) *
            16U);


    const uint32_t
        rowTilesPerBatch =

        (
            shape.m +
            splitM - 1
        ) /
        splitM;


    const uint32_t
        totalRowTiles =

        shape.b *
        rowTilesPerBatch;


    const uint32_t
        hardwareCubeCores =

        platform
            ->GetCoreNumAic();


    if (
        hardwareCubeCores ==
        0
    ) {

        Fail();
    }


    uint32_t blocks =

        static_cast<uint32_t>(

            std::min<int64_t>(

                availableCoreNum,

                static_cast<int64_t>(
                    hardwareCubeCores)
            )
        );


    blocks =
        std::min<uint32_t>(
            blocks,
            totalRowTiles);


    if (
        blocks == 0
    ) {

        blocks = 1;
    }


    const uint32_t splitN =

        std::min<uint32_t>(

            MAX_TILE_N,

            (
                (
                    shape.n +
                    15U
                ) /
                16U
            )
            *
            16U
        );


    const
    matmul_tiling::DataType
        inputType =

        inputDtype == 1

        ?
        matmul_tiling::
            DataType::
                DT_FLOAT16

        :
        matmul_tiling::
            DataType::
                DT_BFLOAT16;


    // ------------------------------------------------------------------------
    // Matmul tiling
    // ------------------------------------------------------------------------

    matmul_tiling::
        MatmulApiTiling
            tiler(*platform);


    CheckTiling(
        tiler.SetAType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            inputType,

            transposeX1
        )
    );


    CheckTiling(
        tiler.SetBType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            inputType,

            transposeX2
        )
    );


    CheckTiling(
        tiler.SetCType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            matmul_tiling::
                DataType::
                    DT_FLOAT
        )
    );


    CheckTiling(
        tiler.SetBias(
            false)
    );


    CheckTiling(
        tiler.SetOrgShape(
            shape.m,
            shape.n,
            shape.k)
    );


    CheckTiling(
        tiler.SetShape(

            std::min<uint32_t>(
                splitM,
                shape.m),

            shape.n,

            shape.k)
    );


    CheckTiling(
        tiler.SetBufferSpace(
            -1,
            -1,
            -1)
    );


    /*
     * (baseM, baseN, M 窗口) 的联合请求阶梯，全部由 SetFixSplit/GetTiling 的
     * **返回值**驱动，不猜、不校验后自杀：
     *   * 窗口从 MAX_WINDOW_BLOCKS 逐档退到 1（M 优先迭代顺序才允许 >1，见下）；
     *   * baseM 档：先 splitM（= min(MAX_BASE_M, ceil16(m))），最后退回基线用的 16；
     *   * baseN 档：从 splitN 一路退到 8；
     *   * 最后那一档 = 基线（真机 15/15）的 (16, splitN)，一定拿得到 tiling。
     *
     * 窗口为什么要跟迭代顺序绑定：kernel 侧按 `mBlk = tileIdx % mBlocks` 把分片
     * 路由到各行块的归并区，而这个解码只在"先 M 轴再 N 轴"成立（`Iterate.md:21`
     * 说这是默认顺序，`TCubeTiling` 记 iterateOrder=0）。一旦 tiler 给出别的顺序，
     * 只接受窗口为 1 的档（退化回单行块，解码无歧义）。
     */
    CubeTiling tiling;

    /*
     * baseN 的请求顺序：
     *   第一档 = splitN 本身（就是基线用的那个 baseN 口径，保证"基线能出的 tiling 我们也能出"）；
     *   然后方阵优先带 128 → 64 → 32 → 16 → 8（baseM≈baseN，L0C 留出 dbL0C=2）；
     *   最后才是大 baseN 兜底带 256 → 192 → 160 → 96（只有 tiler 对某些 shape 只肯给
     *   更大的 baseN 时才用得上；那时分片是 128×baseN，dbL0C=1，是"能用"而不是"最优"）。
     */
    static const int32_t BASE_N_LADDER[] = {
        128, 64, 32, 16, 8,
        256, 192, 160, 96
    };

    static const uint32_t BASE_N_LADDER_COUNT =
        static_cast<uint32_t>(
            sizeof(BASE_N_LADDER) /
            sizeof(BASE_N_LADDER[0]));


    int32_t chosenM = 0;
    int32_t chosenN = 0;

    for (uint32_t stage = 0;
         stage < 2U && chosenN == 0;
         ++stage) {

        /* stage 0 = 方阵档；stage 1 = 基线（真机 15/15）用的 (16, splitN) 兜底档 */
        const uint32_t singleMBase =
            (stage == 0U)
                ? splitM
                : 16U;

        tiler.SetShape(

            std::min<uint32_t>(
                singleMBase,
                shape.m),

            shape.n,

            shape.k);

        const int32_t baseMRequest =
            static_cast<int32_t>(
                singleMBase);

        {

            for (uint32_t slot = 0;
                 slot <= BASE_N_LADDER_COUNT;
                 ++slot) {

                const int32_t request =
                    (
                        slot == 0U
                    )
                        ? static_cast<int32_t>(
                              splitN)
                        : BASE_N_LADDER[
                              slot -
                              1U];

                /* 只允许 baseN <= splitN（= ceil8(singleN) 口径）且不小于 8，并去重 */
                if (
                    request < 8 ||
                    request >
                        static_cast<int32_t>(
                            splitN) ||
                    (
                        slot > 0U &&
                        request ==
                            static_cast<int32_t>(
                                splitN)
                    )
                ) {

                    continue;
                }

                if (
                    tiler.SetFixSplit(
                        baseMRequest,
                        request,
                        -1) != 0
                ) {

                    continue;
                }

                if (
                    tiler.GetTiling(
                        tiling) != 0
                ) {

                    continue;
                }

                chosenM = baseMRequest;
                chosenN = request;

                break;
            }
        }
    }


    if (chosenN == 0) {

        Fail();
    }


    /*
     * 用最终选定的配置**重算一次**，保证拿到的 tiling 来自一次干净的
     * setter -> getter（与基线完全同构），而不是多次试探后的残留状态。
     */
    CheckTiling(
        tiler.SetShape(

            std::min<uint32_t>(
                static_cast<uint32_t>(
                    chosenM),
                shape.m),

            shape.n,

            shape.k)
    );


    CheckTiling(
        tiler.SetFixSplit(
            chosenM,
            chosenN,
            -1)
    );


    CheckTiling(
        tiler.GetTiling(
            tiling)
    );


    /*
     * 回读校验 —— 只保留 kernel 侧**真的会**依赖的必要条件：
     *   * 上界：UB 缓冲与 GM 槽位都按 MAX_* 分配，回读值不得超；
     *   * baseN 8 对齐：WholeReduceMax 的行距按 datablock(32B) 计。
     * 刻意**不再**要求 baseM >= min(splitM, m)：kernel 的行块步长就是 baseM，
     * validM = min(baseM, m - rowStart) 恒 <= baseM ⇒ mBlocks 恒为 1，
     * 与请求了多少无关。多挂这一条只会把"tiler 自己收敛到更小分片"这种
     * **完全合法**的情况变成 abort —— 而 abort 会被平台 ReplayOnce 重放，
     * 直接违反 "each iteration must launch exactly 1 kernel"（真机实测：
     * 7 个 case 各重放一次就把 75 抬成 110）。
     */
    if (
        tiling.baseM <= 0 ||
        tiling.baseN <= 0 ||
        static_cast<uint32_t>(
            tiling.baseM) > MAX_BASE_M ||
        static_cast<uint32_t>(
            tiling.baseN) > MAX_TILE_N ||
        (
            static_cast<uint32_t>(
                tiling.baseN) &
            7U) != 0U
    ) {

        Fail();
    }


    // ------------------------------------------------------------------------
    // Workspace
    // ------------------------------------------------------------------------

    const size_t systemBytes =

        std::max<size_t>(

            32,

            static_cast<size_t>(

                platform
                    ->GetLibApiWorkSpaceSize()
            )
        );


    void *systemDevice =
        nullptr;


    CheckAcl(
        aclrtMalloc(

            &systemDevice,

            systemBytes,

            ACL_MEM_MALLOC_HUGE_FIRST)
    );


    CheckAcl(
        aclrtMemset(

            systemDevice,

            systemBytes,

            0,

            systemBytes)
    );


    CheckAcl(
        aclrtMemset(

            y,

            static_cast<size_t>(
                shape.b) *
                sizeof(float),

            0,

            static_cast<size_t>(
                shape.b) *
                sizeof(float))
    );


    /*
     * staging：每 worker 一块，元素数 = baseM * (n + baseN)（多留一个分片的余量，
     * 与 kernel 侧的 cStage 公式逐字一致）。
     *
     * 两条必须做对的事：
     *   1. **总占用按预算收缩 blocks**：槽位数 = min(b, 2*blocks)，大 case（n 大、b 大）
     *      下按 blocks 全额申请会要到几百 MB —— 真机上 aclrtMalloc 失败就会走
     *      CheckAcl → abort（status 134），这正是"某个大 case 直接 RE"的典型成因。
     *   2. **malloc 失败继续退让**：再砍 blocks（并行度换内存），只留到 1 块还失败才 Fail。
     */
    static constexpr size_t
        STAGE_BUDGET =
            64ull << 20;


    const size_t stageElems =

        static_cast<size_t>(
            tiling.baseM) *
        (
            static_cast<size_t>(
                shape.n) +
            static_cast<size_t>(
                tiling.baseN)
        );


    const size_t perSlotBytes =
        stageElems *
        sizeof(float);


    while (
        blocks > 1U &&
        std::min<size_t>(
            static_cast<size_t>(
                shape.b),

            static_cast<size_t>(
                2U *
                blocks)) *
                perSlotBytes >
            STAGE_BUDGET
    ) {

        --blocks;
    }


    size_t cBytes =
        std::min<size_t>(

            static_cast<size_t>(
                shape.b),

            static_cast<size_t>(
                2U *
                blocks)) *
        perSlotBytes;


    void *cDevice =
        nullptr;


    while (
        aclrtMalloc(

            &cDevice,

            cBytes,

            ACL_MEM_MALLOC_HUGE_FIRST) !=
        ACL_SUCCESS
    ) {

        if (
            blocks <= 1U
        ) {

            Fail();
        }


        /* 内存不够就砍并行度再来（每块 staging 是刚需，只能少开 worker） */
        --blocks;

        cBytes =
            std::min<size_t>(

                static_cast<size_t>(
                    shape.b),

                static_cast<size_t>(
                    2U *
                    blocks)) *
            perSlotBytes;
    }


    // ------------------------------------------------------------------------
    // Cube + Vector MaxSim + Sum fused in one launch
    // ------------------------------------------------------------------------

    if (
        inputDtype == 1
    ) {

        LaunchMatmulPath<half>(

            x1,

            x2,

            y,

            (GM_ADDR)systemDevice,

            (GM_ADDR)cDevice,

            tiling,

            shape,

            blocks,

            stream,

            transposeX1,

            transposeX2
        );
    }

    else {

        LaunchMatmulPath<
            bfloat16_t>(

            x1,

            x2,

            y,

            (GM_ADDR)systemDevice,

            (GM_ADDR)cDevice,

            tiling,

            shape,

            blocks,

            stream,

            transposeX1,

            transposeX2
        );
    }


    /*
     * workspace 在本函数内部申请，
     * 所以释放前必须确保该 stream
     * 已经完成访问。
     *
     * 超时给足 60s：这个 timeout 只是"本地安全网"，判题有自己的 TLE。
     * 3s（基线值）在本版偏紧 —— 一旦真的超时，CheckAcl 会 Fail ⇒ abort
     * ⇒ 平台 ReplayOnce 重放 ⇒ **多出一次 kernel launch**，直接把
     * "each iteration must launch exactly 1 kernel" 顶破（真机实测 75 → 110）。
     * 宁可在这里等，也不要 abort。
     */
    CheckAcl(
        aclrtSynchronizeStreamWithTimeout(
            stream,
            60000)
    );


    CheckAcl(
        aclrtFree(
            cDevice)
    );


    CheckAcl(
        aclrtFree(
            systemDevice)
    );
}

} // namespace bmmms


// ============================================================================
// Contest ABI
// ============================================================================

extern "C" void run_kernel(
    GM_ADDR x1,
    const TensorGroupInfo &info_x1,

    GM_ADDR x2,
    const TensorGroupInfo &info_x2,

    GM_ADDR y,
    const TensorGroupInfo &info_y,

    int64_t availableCoreNum,

    aclrtStream stream,

    bool transposeX1,

    bool transposeX2)
{
    bmmms::Launch(

        x1,
        info_x1,

        x2,
        info_x2,

        y,
        info_y,

        availableCoreNum,

        stream,

        transposeX1,

        transposeX2
    );
}


// ============================================================================
// VERIFY —— 上板必查（本机无 CANN / NPU，以下都**没有**本地证据）
//
// 0) 【判题硬规则】一次迭代只能启动 1 个 kernel；**任何 abort（host Fail() →
//    status 134）都会被平台 <ReplayOnce> 重放，每次重放多算一次 launch**。
//    真机原文："Expected 75 launches, got 110"（110 = 75 + 7×5）。
//    本版保留修复：分片阶梯末档 = 基线配置、回读只留必要上界、同步超时 60s。
//    本地门禁：`python tools/launch_check.py kernel.asc`（启动点互斥、无同块并联）。
//
// 1) 【本版最高风险】`mm.IterateAll(cStage, 0, true)` 在 MIX（KFC）kernel 里的行为。
//    文档依据：`IterateAll.md:20-70` —— 默认同步（"需要同步等待IterateAll执行结束"）、
//    A2/A3 支持、示例就是 REGIST_MATMUL_OBJ + SetTensorA/B + IterateAll(gm_c)；
//    约束是"C 地址空间 ≥ singleCoreM*singleCoreN"。但**本机没有编译/上板证据**。
//    失败特征分两种：
//      a. 编译期：这个重载/参数组合不被接受 → 直接编译错误（信息明确）；
//      b. 运行期：**只有 m 不是 baseM 整数倍的 case 错**（见第 2 条）。
// 2) 【本版第二风险】连续写（enSequentialWrite=true）在**行块只有一个 M 块**时的
//    分片步进：本版假设第 t 个 N 分片落在 cStage[t * validM * baseN]，即"按有效尺寸
//    [validM, baseN] 紧挨着铺"（依据：123b2b8 已实测尾片按 validN 紧凑打包，
//    即步进按**有效**尺寸而非补齐尺寸）。
//    失败特征：**m % baseM != 0 的 case 错**（其它 case 正确）—— 若出现，说明步进是
//    补齐尺寸 baseM*baseN，把 kernel 里的 `validM * baseN` 改成 `baseM * baseN`
//    并把 staging 的读取范围按同样口径改一遍即可（本文件已把该表达式集中在两处：
//    cStage 的片偏移，以及 staging 的槽位大小）。
// 3) 两级归约参数：第一级 WholeReduceMax(mask=min(64, 余列数), repeat≤255 分批,
//    dstRepStride=1(连续), srcBlkStride=1, srcRepStride=baseN/8, ORDER_ONLY_VALUE)；
//    第二级用**元素级 Max** 把各列组折起来（不是再调一次归约 —— 组值之间隔 8 个 float，
//    靠归约的连续 mask 是读不到的，这个坑本地复算抓到过）。
//    失败特征：行最大值取到了别的行/别的组的数据（结果系统性偏大或错位）。
//    报障时把 baseM/baseN 与实际 shape 给我，这两个数的组合能反推参数该取多少。
// 4) N 尾块标量路径（沿用 15/15 已验证的读法）：连续写在尾片按 validN 紧凑打包，
//    行距 = validN、行首不保证 32B 对齐，所以用 scalar GetValue 逐行读。
// 5) tiler 回读：host 只 Fail"kernel 侧真的会依赖"的必要条件（baseM ≤ 128、
//    baseN ≤ **256**、baseN % 8 == 0）—— 上限与真机 15/15 的基线同口径，
//    **绝不比基线更严**（更严 ⇒ 多出 abort ⇒ 平台 ReplayOnce 重放 ⇒ 多算 launch，
//    这正是 "Expected 75, got 110" 的来源：差值 35 = 7 个 case × 5 次迭代）。
//    上板请打印 baseM/baseN：优先期望 128×128（方阵、dbL0C=2）；
//    若 tiler 只给 128×256（dbL0C=1）或更小的 baseN，正确性都不变，只是少赚。
// 6) UB 预算：cUb(1×128×256×4 = 131072，容得下 baseN=256 的单个分片)
//    + groupMax(GROUP_MAX*MAX_ROWS*4 = 2560) + rowMax/tailMax/rowOut(≈1.5KB)
//    ≈ 135KB / 192KB。
// 7) GM 预算：staging = min(b, 2*blocks) × baseM × (n+baseN) × 4B，但**总占用被
//    64MB 预算收缩**（收缩方式是少开 worker），malloc 失败还会继续砍 blocks 重试。
//    上板确认没有再出现 status 134/ReplayOnce。
//    若还崩在某个大 case 上，把该 case 的 b/m/n/k 给我 —— 下一步是把 staging 换成
//    "按 N 窗口分块"（只在 TRANSPOSE_B=true 时可用，B 的列窗口是连续地址）。
// 8) 确定性：本版只有"跨分片取 max"，无原子、无浮点累加顺序问题 ⇒ 结果应逐位可复现
//    （题面要求多次执行结果一致）。
// 9) 精度：数值路径与基线一致（先跨 N 取 max，再按行升序求和），精度结论沿用
//    PRECISION-REPORT.md（余量约 1000×）。
// ============================================================================
