// ============================================================================
// kernel.asc — BatchMatmulMaxSum @ 910C (Atlas A3 / __NPU_ARCH__=2201)
//
// 基线 = 队友 push 的 origin/main（f5b3995，kernel.asc blob 3e96fd39，真机 15/15）。
// 本版继续只做「少穿 GM」，数学语义、任务划分、输出写回方式不变。
//
// 三条杠杆（完整推导与文档出处见下方 MatmulMaxKernel 前的长注释）：
//   [1] **一次 `IterateAll` 算完一个行块**（同步语义，`IterateAll.md:20-70`）：
//       AIV↔AIC 的握手从"每个 N 分片一次"（m=4096/n=4096 时每 batch 1024 次）
//       降到"每个行块一次"（32 次）—— 这是本版唯一的关键差别，也是它快的原因。
//       上一版虽然把分片放大到 128×128，但握手仍是每片一次，所以快不了多少。
//   [2] 连续写把同一行块的 N 个分片按 [validM, baseN] 顺序紧挨着铺在 GM staging 里，
//       AIV 一次 DataCopyPad 读回 READ_TILES=2 片（128KB），把 UB 一次铺满。
//   [3] 归约 = 两级 WholeReduceMax（64 列一组 → 每行的组折成 1）+ 跨分片 Max：
//       全程无原子、与分片顺序无关；N 尾块走基线已实测的标量逐行读法。
//   tiler 拒绝某档就逐档退让（baseN: 128→…→8、baseM: 128→16），
//   最后一档 = 基线（真机 15/15）用的 (16, splitN)，一定拿得到 tiling。
//
// GM 往返账（单 batch、每行块，baseM=baseN=128）：Fixpipe 写 n/baseN 片（每片 64KB）、
//   AIV 读 ceil((n/baseN)/2) 次（每次 128KB）+ 尾块一次；**同步只有 1 次**。
// 单核 M = validM ≤ baseM ⇒ 一个行块内只有 1 个 M 块，分片产出顺序对本 kernel 无影响。
//
// 【真机反馈：第 8 个点 RE（status 134）】日志里崩的是某个大 shape 的
//   MatmulMaxKernel<bf16,1,1>（同一个模板前面 Block Dim 4 的用例都正常，崩的那次 Block Dim 9）。
//   134 = host abort。本版把 v5 引入的两条"随 shape 变化的自伤路径"堵上：
//     * staging 总占用按 64MB 预算收缩 blocks，并且 **aclrtMalloc 失败时继续砍 blocks 重试**
//       （v5 按 blocks 全额申请，n 大、b 大时会要几百 MB，malloc 失败即 abort）；
//     * staging 每块多留**一个分片**的余量（baseM*(n+baseN)），并且非活动 worker 的
//       槽位下标夹到 0 —— 保证无论连续写的步进按有效尺寸还是补齐尺寸都不会越界。
//
// ⚠ 本机没有 CANN / NPU：本文件**未编译、未上板**。上板必查清单见文件末尾 VERIFY。
//
// 【判题硬规则（真机反馈原文）】
//   "Profiling rule violated: each iteration must launch exactly 1 kernel.
//    Expected 75 launches, got 110."
//   一次迭代只能启动 1 个 kernel；**而且任何 abort（host Fail() / status 134）都会被
//   平台 <ReplayOnce> 重放，每次重放多算一次 launch**（110 = 75 + 7×5）。
//   本版保留上一版的修复：所有"我方主动 Fail"的路径都改成"退让到基线兜底档"，
//   回读校验只留 kernel 侧真正依赖的必要条件。启动点只有两处（小路径 / 主路径），
//   互斥分支，任一时刻只走一个 —— 本地用 tools/launch_check.py 守这条规则。
// ============================================================================

#include <cstdint>
#include <cstdlib>
#include <algorithm>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"

namespace bmmms {

using namespace AscendC;
using CubeTiling = AscendC::tiling::TCubeTiling;

/*
 * 分片上限。L0C = 128KB、C 为 float ⇒ baseM*baseN*4 ≤ 131072。
 * 取 128 x 128 = 16384（64KB/片 ⇒ dbL0C = 2，Mmad 与 Fixpipe 可重叠）。
 *
 * 为什么是"方阵"：AIC 从 GM 取操作数的量是
 *     (n/baseN)*m*k*2  +  (m/baseM)*n*k*2
 * （每个 C 分片都要把 A 的 baseM×k、B 的 k×baseN 面板各流过一遍 L1），
 * 在 baseM*baseN 受 L0C 限制时，这个和由 AM-GM 在 baseM ≈ baseN 处最小。
 * 128x128 同时让 L0C 留出双缓冲，所以取它；tiler 拒绝时 Launch 会逐档退让。
 */
static constexpr uint32_t MAX_BASE_M = 128;

/*
 * baseN 上限取 **256** —— 与队友那版真机 15/15 的基线同一个口径。
 * 教训：我中间几版把它压到 128，等于"比基线更严"；一旦 tiler 对某些 shape
 * 只肯给更大的 baseN，就会走到 host 的 Fail() → abort → 平台 ReplayOnce 重放
 * → 多算一次 kernel launch → 直接违反 "each iteration must launch exactly 1 kernel"
 * （真机原文 Expected 75, got 110，差值 35 = 7 个 case × 5 次迭代）。
 * 请求阶梯仍然**优先**方阵 128（L0C 64KB/片、dbL0C=2），只在方阵带全败时才用大 baseN。
 */
static constexpr uint32_t MAX_TILE_N = 256;

/*
 * 每次 DataCopyPad 读回的分片数。取 1：UB 必须容得下 baseN 到 256 的单个分片
 * （128*256*4 = 128KB），再乘 2 就超 192KB 了。读次数多一次没关系 ——
 * 本版省的是**同步次数**（每行块 1 次），不是读次数。
 */
static constexpr uint32_t READ_TILES = 1;
static constexpr uint64_t SMALL_MAC_LIMIT = 32768;
static constexpr float NEG_INF = -3.402823466e38f;

struct Shape {
    uint32_t b;
    uint32_t m;
    uint32_t n;
    uint32_t k;
};


// ============================================================================
// Device helpers
// ============================================================================

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

__aicore__ inline float AbsF32(float x)
{
    return x < 0.0f ? -x : x;
}

__aicore__ inline float Decode(half x)
{
    return static_cast<float>(x);
}

__aicore__ inline float Decode(bfloat16_t x)
{
    return AscendC::ToFloat(x);
}

__aicore__ inline void AddCompensated(
    float value,
    float &sum,
    float &correction)
{
    const float next = sum + value;

    if (AbsF32(sum) >= AbsF32(value)) {
        correction += (sum - next) + value;
    } else {
        correction += (value - next) + sum;
    }

    sum = next;
}

template <HardEvent E>
__aicore__ inline void Fence(TPipe &pipe)
{
    const event_t event =
        static_cast<event_t>(
            pipe.FetchEventID(E));

    SetFlag<E>(event);
    WaitFlag<E>(event);
}


// ============================================================================
// Small-input path
// ============================================================================

template <typename InputT>
__global__ __aicore__ void SmallKernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    Shape shape,
    bool transposeX1,
    bool transposeX2)
{
    if (GetBlockIdx() != 0) {
        return;
    }

    TPipe pipe;

    TBuf<TPosition::VECCALC> outBuf;

    pipe.InitBuffer(
        outBuf,
        64 * sizeof(float));

    LocalTensor<float> outLocal =
        outBuf.Get<float>();


    GlobalTensor<InputT> a;
    GlobalTensor<InputT> b;
    GlobalTensor<float> out;


    a.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x1),
        static_cast<uint64_t>(shape.b) *
            shape.m *
            shape.k);


    b.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x2),
        static_cast<uint64_t>(shape.b) *
            shape.n *
            shape.k);


    out.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(y),
        shape.b);


    for (uint32_t batch = 0;
         batch < shape.b;
         ++batch) {

        const uint64_t aBase =
            static_cast<uint64_t>(batch) *
            shape.m *
            shape.k;


        const uint64_t bBase =
            static_cast<uint64_t>(batch) *
            shape.n *
            shape.k;


        float total = 0.0f;
        float totalCorr = 0.0f;


        for (uint32_t row = 0;
             row < shape.m;
             ++row) {

            float best = 0.0f;


            for (uint32_t col = 0;
                 col < shape.n;
                 ++col) {

                float dot = 0.0f;
                float dotCorr = 0.0f;


                for (uint32_t kk = 0;
                     kk < shape.k;
                     ++kk) {

                    const uint64_t aOffset =
                        aBase +
                        (
                            transposeX1
                                ?
                                static_cast<uint64_t>(kk) *
                                        shape.m +
                                    row
                                :
                                static_cast<uint64_t>(row) *
                                        shape.k +
                                    kk
                        );


                    const uint64_t bOffset =
                        bBase +
                        (
                            transposeX2
                                ?
                                static_cast<uint64_t>(col) *
                                        shape.k +
                                    kk
                                :
                                static_cast<uint64_t>(kk) *
                                        shape.n +
                                    col
                        );


                    const float product =
                        Decode(
                            a.GetValue(aOffset)
                        )
                        *
                        Decode(
                            b.GetValue(bOffset)
                        );


                    AddCompensated(
                        product,
                        dot,
                        dotCorr);
                }


                const float score =
                    dot + dotCorr;


                if (col == 0 ||
                    score > best) {

                    best = score;
                }
            }


            AddCompensated(
                best,
                total,
                totalCorr);
        }


        outLocal.SetValue(
            batch,
            total + totalCorr);
    }


    Fence<HardEvent::S_MTE3>(
        pipe);


    DataCopyExtParams copyOut;

    copyOut.blockCount = 1;

    copyOut.blockLen =
        shape.b *
        sizeof(float);

    copyOut.srcStride = 0;
    copyOut.dstStride = 0;
    copyOut.rsv = 0;


    DataCopyPad(
        out,
        outLocal,
        copyOut);


    Fence<HardEvent::MTE3_S>(
        pipe);


    PipeBarrier<PIPE_ALL>();
}


// ============================================================================
// Cube Matmul + Vector MaxSim
// ============================================================================
//
// 本版目标：一行块**只同步一次**，且把队友在 910C 真机上探到的搬运/归约口径照搬过来。
//
// 【队友 910C 真机探明的三条硬事实】（见其 handoff / bench sweep，本目录
//   teammate-161cf4c.asc 是那一版原件）
//   1. `IterateAll` 的条带布局：**slot 步进 = baseM*baseN**（不是 validM*baseN），
//      slot 内**行的步进 = 该 tile 自己的 validN**，且只写有效行。
//      ⇒ 读回时偏移要按 `t*baseM*baseN` 算，行距按 validN 算。
//   2. **singleM < baseM 会多出一个 ghost tile** ⇒ M 尾块（validM < baseM）不能走
//      IterateAll，必须退回逐 tile 的 `Iterate()/GetTensorC()`。
//   3. 瓶颈是**单核 MTE2 流式带宽 ~38GB/s/core**（不是 HBM 总量、不是 K 步延迟）
//      ⇒ 该省的“GM 搬运次数/字节”比“向量指令条数”重要得多。
//
// 由此本版相对上一版改三处：
//   [A] 读回偏移改成 `t*baseM*baseN`（原来按 validM*baseN 算 = 错的）；
//   [B] M 尾块走逐 tile 的 Iterate/GetTensorC（避免 ghost tile 打乱 slot 网格）；
//   [C] 归约退回**真机 15/15 基线验证过**的逐行 `ReduceMax(..., validN, false)`
//       + N 尾块的标量逐行读（原来那套两级 WholeReduceMax 是向量指令更省，
//       但真机瓶颈在 MTE2，不是向量指令；用已证路径更稳）。
//   另外把 `SetOrgShape` 提到循环外（它是真正的 KFC 消息，org shape 恒定）。
//
// 与队友那版的关键差别（也是本版保留的优势）：**整个归约都在同一个 device kernel 里
// 完成**，不需要第二个 kernel、也不把跨 chunk 的 max / 行和搬到 Host CPU 上算
// （赛题规则明说“核心计算必须在昇腾 NPU 上由 AscendC 算子完成，转到 Host CPU 构成违规”）。
//
// M 尾块 / N 尾块的语义与基线一致：行最大值 = 跨 N 取 max（可交换可结合），
// 行和只在 row < validM 上做，最后每 batch 只写一个 float 到 y[batch]。
// ============================================================================

template <
    typename InputT,
    bool TRANSPOSE_A,
    bool TRANSPOSE_B>
__global__ __aicore__ void MatmulMaxKernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    __kfc_workspace__ GM_ADDR systemWorkspace,
    GM_ADDR cWorkspace,
    CubeTiling tiling,
    Shape shape,
    uint32_t workerCount)
{
    TPipe pipe;


    using AType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            InputT,
            TRANSPOSE_A>;


    using BType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            InputT,
            TRANSPOSE_B>;


    using CType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            float>;


    Matmul<
        AType,
        BType,
        CType> mm;


    REGIST_MATMUL_OBJ(
        &pipe,
        GetSysWorkSpacePtr(),
        mm,
        &tiling);


    /*
     * UB 缓冲按编译期上限分配，实际几何全部取自 tiling 回读值：
     *   cUb        : 一次读回一个 slot（baseM*baseN 个 float，最坏 128*256*4 = 128KB）
     *   reduceWork : ReduceMax 的中间缓冲（count ≤ baseN 时 fp32 只需
     *                RoundUp(RoundUp(count/64)*2, 8) 个元素，给 MAX_TILE_N 足够）
     *   其余三个   : 每行一个 float
     */
    TBuf<TPosition::VECCALC> cTileBuf;
    TBuf<TPosition::VECCALC> reduceWorkBuf;
    TBuf<TPosition::VECCALC> tileMaxBuf;
    TBuf<TPosition::VECCALC> bestBuf;
    TBuf<TPosition::VECCALC> rowOutBuf;


    pipe.InitBuffer(
        cTileBuf,
        MAX_BASE_M *
            MAX_TILE_N *
            sizeof(float));


    pipe.InitBuffer(
        reduceWorkBuf,
        MAX_TILE_N *
            sizeof(float));


    pipe.InitBuffer(
        tileMaxBuf,
        MAX_BASE_M *
            sizeof(float));


    pipe.InitBuffer(
        bestBuf,
        MAX_BASE_M *
            sizeof(float));


    pipe.InitBuffer(
        rowOutBuf,
        MAX_BASE_M *
            sizeof(float));


    LocalTensor<float>
        cUb =
            cTileBuf.Get<float>();


    LocalTensor<float>
        reduceWork =
            reduceWorkBuf.Get<float>();


    LocalTensor<float>
        tileMaxVec =
            tileMaxBuf.Get<float>();


    LocalTensor<float>
        bestVec =
            bestBuf.Get<float>();


    LocalTensor<float>
        rowOut =
            rowOutBuf.Get<float>();


    /*
     * tiling 回读值。host 侧只校验 kernel 侧真正依赖的边界：
     * baseM ≤ MAX_BASE_M、baseN ≤ MAX_TILE_N、baseN % 8 == 0。
     */
    const uint32_t baseM =
        static_cast<uint32_t>(
            tiling.baseM);


    const uint32_t baseN =
        static_cast<uint32_t>(
            tiling.baseN);


    GlobalTensor<InputT> a;
    GlobalTensor<InputT> b;
    GlobalTensor<float> out;


    a.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x1),

        static_cast<uint64_t>(
            shape.b) *
            shape.m *
            shape.k);


    b.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x2),

        static_cast<uint64_t>(
            shape.b) *
            shape.n *
            shape.k);


    const uint32_t worker =
        static_cast<uint32_t>(
            GetBlockIdx());


    /*
     * AIV 的 GetBlockIdx() 枚举 [0, 2*blocks)，AIC 侧从 0 重新枚举；只有 id < b 的
     * worker 会真正进 task 循环，其余一律夹到 0 号槽，保证任何 worker 算出的地址都合法
     * （真机上 status 134 的一个来源就是非活动 worker 算出了越界地址）。
     */
    const uint32_t workers =
        workerCount;


    const uint32_t stageSlots =
        MinU32(
            shape.b,
            workers);


    uint32_t cSlot =
        worker;

    if (cSlot >= stageSlots) {

        cSlot = 0U;
    }


    /*
     * staging：每个 worker 一块，按**slot 网格**给足：
     *   ceil(n/baseN) 个 slot × baseM*baseN 个元素（slot 步进 = baseM*baseN，真机探明）
     * 再补一个 slot 的余量，任何合法的尾块写都不会越界。host 侧同公式申请。
     */
    const uint32_t nTilesAll =
        (
            shape.n +
            baseN -
            1U
        ) /
        baseN;


    const uint32_t cSlotElems =
        (
            nTilesAll +
            1U
        ) *
        baseM *
        baseN;


    GlobalTensor<float> cTile;


    cTile.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(cWorkspace) +
            static_cast<uint64_t>(
                cSlot) *
                cSlotElems,

        cSlotElems);


    /*
     * 原子加槽位区放在 staging 之后：每 batch 8 个 float（32B），只有第 0 个是
     * 真正的行块和，其余 7 个恒 0（host 前置 0）。staging 每个槽位 cSlotElems 个
     * float（乘 4 字节天然是 32B 的倍数）⇒ 这里一定 32B 对齐，满足 SetAtomicAdd
     * 的块对齐要求。**所有算术都在 AIV 上完成**；host 只在 kernel 之后把这 8 个里的
     * 第 0 个 float 用 aclrtMemcpy **拷**进 y（纯搬运、不做算术）。
     */
    out.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(cWorkspace) +
        static_cast<uint64_t>(
            stageSlots) *
            cSlotElems,

        static_cast<uint64_t>(
            shape.b) *
            8U);


    /* org shape 恒定，且它是真正的 KFC 消息 —— 提到循环外只发一次 */
    mm.SetOrgShape(
        shape.m,
        shape.n,
        shape.k);


    /*
     * 一个 task = 一个 batch：属主 AIV 走完它的所有行块，行和累在寄存器里，
     * 最后只写一个 float 到 y[batch]。无原子、无跨 worker 累加、无第二阶段。
     */
    /*
     * task = (batch, 行块)：**粒度按核数选**，不是为了好看。
     * 旧写法 task = 一个 batch ⇒ b=1 时全场只有一个 AIC+AIV 对在干活，其余核空转，
     * 这才是 CrossCoreWait 的大头（不是消息慢，是没活干）。
     * 现在每个行块一个 task，task 数 = b*ceil(m/baseM)，由 host 保证 ≥ 6×cube core 数；
     * 每个 task 仍然独占**整行**（N 方向不切），所以行内不需要任何跨 task 归并，
     * 唯一的跨 task 合并是"行块和 → y[batch]"，用 32B 对齐的原子加完成。
     */
    const uint32_t rowTiles =
        (
            shape.m +
            baseM -
            1U
        ) /
        baseM;


    const uint32_t totalTasks =
        shape.b *
        rowTiles;


    for (uint32_t task = worker;
         task < totalTasks;
         task += workers) {

        const uint32_t batch =
            task /
            rowTiles;


        const uint32_t rowStart =
            (
                task %
                rowTiles
            ) *
            baseM;


        float taskSum = 0.0f;


        {

        const uint32_t validM =
            MinU32(
                baseM,
                shape.m -
                    rowStart);


        const uint64_t aOffset =
            static_cast<uint64_t>(
                batch) *
                shape.m *
                shape.k
            +
            (
                TRANSPOSE_A
                    ?
                    static_cast<uint64_t>(
                        rowStart)
                    :
                    static_cast<uint64_t>(
                        rowStart) *
                        shape.k
            );


        const uint64_t bOffset =
            static_cast<uint64_t>(
                batch) *
                shape.n *
                shape.k;


        mm.SetSingleShape(
            validM,
            shape.n,
            shape.k);


        mm.SetTensorA(
            a[aOffset],
            TRANSPOSE_A);


        mm.SetTensorB(
            b[bOffset],
            TRANSPOSE_B);


        const uint32_t nTiles =
            (
                shape.n +
                baseN -
                1U
            ) /
            baseN;


        /*
         * 【事实 2】singleM < baseM 会让 IterateAll 多吐一个 ghost tile，
         * slot 网格就乱了 ⇒ M 尾块退回逐 tile 的 Iterate/GetTensorC。
         */
        const bool stripAtOnce =
            (
                validM >=
                baseM
            );


        if (stripAtOnce) {

            /* 【杠杆】一个行块只同步一次：整条 [validM, n] 由这次调用算完并搬出 */
            mm.IterateAll(
                cTile,
                0U,
                true);
        }


        Duplicate(
            bestVec,
            NEG_INF,
            static_cast<int32_t>(
                MAX_BASE_M));


        for (uint32_t t = 0;
             t < nTiles;
             ++t) {

            const uint32_t validN =
                MinU32(
                    baseN,
                    shape.n -
                        t *
                            baseN);


            if (!stripAtOnce) {

                if (!mm.Iterate()) {

                    break;
                }


                mm.GetTensorC(
                    cTile,
                    0U,
                    true);
            }


            /*
             * 【事实 1】slot 步进 = baseM*baseN（不是 validM*baseN）；
             * 逐 tile 路径每次都写回同一个 slot，所以偏移恒为 0。
             */
            Fence<
                HardEvent::V_MTE2>(
                    pipe);


            DataCopyExtParams
                copyTile;

            copyTile.blockCount = 1;

            copyTile.blockLen =
                validM *
                validN *
                sizeof(float);

            copyTile.srcStride = 0;
            copyTile.dstStride = 0;
            copyTile.rsv = 0;


            DataCopyPadExtParams<float>
                padTile;


            DataCopyPad(
                cUb,
                cTile[
                    stripAtOnce
                        ?
                    t *
                        baseM *
                        baseN
                        :
                    0U
                ],
                copyTile,
                padTile);


            Fence<
                HardEvent::MTE2_V>(
                    pipe);


            Duplicate(
                tileMaxVec,
                NEG_INF,
                static_cast<int32_t>(
                    MAX_BASE_M));


            if (validN == baseN) {

                /*
                 * 整片：逐行 ReduceMax（真机 15/15 基线验证过的路径），
                 * 行距 = baseN。
                 */
                for (uint32_t row = 0;
                     row < validM;
                     ++row) {

                    ReduceMax(
                        tileMaxVec[
                            row
                        ],
                        cUb[
                            row *
                            baseN
                        ],
                        reduceWork,
                        static_cast<int32_t>(
                            validN),
                        false);
                }

            } else {

                /*
                 * N 尾片：连续写在尾片按 validN 紧凑打包，行距 = validN、
                 * 行首不保证 32B 对齐 —— 用标量逐行读（基线的结论）。
                 */
                for (uint32_t row = 0;
                     row < validM;
                     ++row) {

                    float rowBest =
                        NEG_INF;

                    const uint32_t srcBase =
                        row *
                        validN;

                    for (uint32_t col = 0;
                         col < validN;
                         ++col) {

                        const float v =
                            cUb.GetValue(
                                srcBase + col);

                        if (v > rowBest) {
                            rowBest = v;
                        }
                    }


                    tileMaxVec.SetValue(
                        row,
                        rowBest);
                }
            }


            Max(
                bestVec,
                bestVec,
                tileMaxVec,
                static_cast<int32_t>(
                    MAX_BASE_M));
        }


        Fence<
            HardEvent::V_S>(
                pipe);


        float tileSum = 0.0f;


        for (uint32_t row = 0;
             row < validM;
             ++row) {

            tileSum +=
                bestVec
                    .GetValue(row);
        }


        taskSum += tileSum;


        Fence<
            HardEvent::S_V>(
                pipe);
        }


        if
            ASCEND_IS_AIV
        {

            /*
             * 行块和 → y[batch]：跨 task 的唯一合并。
             * 用 32B 对齐的原子加（SetAtomicAdd<float>），所以目标必须是一整块 32B：
             * 槽内 = [和, 0, 0, 0, 0, 0, 0, 0]，那 7 个 0 加进去不改变结果。
             * host 侧在 kernel 前置 0、kernel 后用 aclrtMemcpy2d 把每 batch 的第 0 个
             * float 拷进 y —— 只做搬运，不做任何算术（算术全在 NPU 上完成）。
             */
            Duplicate(
                rowOut,
                0.0f,
                static_cast<int32_t>(
                    8));


            rowOut.SetValue(
                0,
                taskSum);


            Fence<
                HardEvent::S_MTE3>(
                    pipe);


            DataCopyExtParams
                copyOut;

            copyOut.blockCount = 1;

            copyOut.blockLen =
                8U *
                sizeof(float);

            copyOut.srcStride = 0;
            copyOut.dstStride = 0;
            copyOut.rsv = 0;


            SetAtomicAdd<float>();


            DataCopyPad(
                out[
                    batch *
                    8U
                ],
                rowOut,
                copyOut);


            SetAtomicNone();


            Fence<
                HardEvent::MTE3_S>(
                    pipe);
        }
    }


    mm.End();


    PipeBarrier<PIPE_ALL>();
}


// ============================================================================
// Host helpers
// ============================================================================

[[noreturn]]
inline void Fail()
{
    std::abort();
}


inline void CheckAcl(
    aclError result)
{
    if (result !=
        ACL_SUCCESS) {

        std::abort();
    }
}


inline void CheckTiling(
    int64_t result)
{
    if (result < 0) {
        std::abort();
    }
}


inline const TensorInfo &
SingleTensor(
    const TensorGroupInfo &info)
{
    if (
        info.numTensors != 1 ||
        info.tensors == nullptr ||
        info.tensors[0].shape ==
            nullptr
    ) {

        Fail();
    }


    return
        info.tensors[0];
}


// ============================================================================
// Metadata parsing
// ============================================================================

inline Shape ParseShape(
    const TensorGroupInfo &infoX1,
    const TensorGroupInfo &infoX2,
    const TensorGroupInfo &infoY,
    bool transposeX1,
    bool transposeX2)
{
    const TensorInfo &a =
        SingleTensor(infoX1);


    const TensorInfo &b =
        SingleTensor(infoX2);


    const TensorInfo &out =
        SingleTensor(infoY);


    if (
        a.numDims != 3 ||
        b.numDims != 3 ||
        out.numDims != 1
    ) {
        Fail();
    }


    if (
        a.dtype != b.dtype ||
        (
            a.dtype != 1 &&
            a.dtype != 2
        ) ||
        out.dtype != 0
    ) {
        Fail();
    }


    const int64_t B =
        a.shape[0];


    const int64_t M =
        a.shape[
            transposeX1
                ? 2
                : 1
        ];


    const int64_t K1 =
        a.shape[
            transposeX1
                ? 1
                : 2
        ];


    const int64_t K2 =
        b.shape[
            transposeX2
                ? 2
                : 1
        ];


    const int64_t N =
        b.shape[
            transposeX2
                ? 1
                : 2
        ];


    if (
        B <= 0 ||
        M <= 0 ||
        N <= 0 ||
        K1 <= 0 ||
        K2 <= 0 ||
        b.shape[0] != B ||
        K1 != K2 ||
        out.shape[0] != B
    ) {

        Fail();
    }


    Shape shape;


    shape.b =
        static_cast<uint32_t>(
            B);


    shape.m =
        static_cast<uint32_t>(
            M);


    shape.n =
        static_cast<uint32_t>(
            N);


    shape.k =
        static_cast<uint32_t>(
            K1);


    return shape;
}


// ============================================================================
// Four storage layouts
// ============================================================================

template <typename InputT>
inline void LaunchMatmulPath(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    GM_ADDR workspace,
    GM_ADDR cWorkspace,
    const CubeTiling &tiling,
    Shape shape,
    uint32_t blocks,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    if (
        !transposeX1 &&
        !transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            false,
            false>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else if (
        !transposeX1 &&
        transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            false,
            true>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else if (
        transposeX1 &&
        !transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            true,
            false>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else {

        MatmulMaxKernel<
            InputT,
            true,
            true>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }
}


// ============================================================================
// Launch
// ============================================================================

inline void Launch(
    GM_ADDR x1,
    const TensorGroupInfo &infoX1,
    GM_ADDR x2,
    const TensorGroupInfo &infoX2,
    GM_ADDR y,
    const TensorGroupInfo &infoY,
    int64_t availableCoreNum,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    const Shape shape =
        ParseShape(
            infoX1,
            infoX2,
            infoY,
            transposeX1,
            transposeX2);


    const int32_t inputDtype =
        infoX1
            .tensors[0]
            .dtype;


    const uint64_t macs =
        static_cast<uint64_t>(
            shape.b)
        *
        shape.m
        *
        shape.n
        *
        shape.k;


    // ------------------------------------------------------------------------
    // Tiny shape path
    // ------------------------------------------------------------------------

    if (
        macs <=
        SMALL_MAC_LIMIT
    ) {

        if (
            inputDtype == 1
        ) {

            SmallKernel<half>
                <<<1,
                   nullptr,
                   stream>>>(
                    x1,
                    x2,
                    y,
                    shape,
                    transposeX1,
                    transposeX2);
        }

        else {

            SmallKernel<bfloat16_t>
                <<<1,
                   nullptr,
                   stream>>>(
                    x1,
                    x2,
                    y,
                    shape,
                    transposeX1,
                    transposeX2);
        }


        return;
    }


    // ------------------------------------------------------------------------
    // Matmul path
    // ------------------------------------------------------------------------

    if (
        availableCoreNum <= 0
    ) {

        Fail();
    }


    platform_ascendc::
        PlatformAscendC *platform =

        platform_ascendc::
            PlatformAscendCManager::
                GetInstance();


    if (
        platform ==
        nullptr
    ) {

        Fail();
    }


    /*
     * baseM/baseN 只按 16 对齐后申请（`SetFixSplit.md` 要求 baseM <= ceil16(singleM)），
     * 实际值一律以 tiler 回读为准，回读值同时决定 UB 缓冲与 GM 槽位的几何。
     */
    const uint32_t splitM =

        std::min<uint32_t>(

            MAX_BASE_M,

            (
                (
                    shape.m +
                    15U
                ) /
                16U
            ) *
            16U);


    const uint32_t
        rowTilesPerBatch =

        (
            shape.m +
            splitM - 1
        ) /
        splitM;


    const uint32_t
        totalRowTiles =

        shape.b *
        rowTilesPerBatch;


    const uint32_t
        hardwareCubeCores =

        platform
            ->GetCoreNumAic();


    if (
        hardwareCubeCores ==
        0
    ) {

        Fail();
    }


    uint32_t blocks =

        static_cast<uint32_t>(

            std::min<int64_t>(

                availableCoreNum,

                static_cast<int64_t>(
                    hardwareCubeCores)
            )
        );


    blocks =
        std::min<uint32_t>(
            blocks,
            totalRowTiles);


    if (
        blocks == 0
    ) {

        blocks = 1;
    }


    const uint32_t splitN =

        std::min<uint32_t>(

            MAX_TILE_N,

            (
                (
                    shape.n +
                    15U
                ) /
                16U
            )
            *
            16U
        );


    const
    matmul_tiling::DataType
        inputType =

        inputDtype == 1

        ?
        matmul_tiling::
            DataType::
                DT_FLOAT16

        :
        matmul_tiling::
            DataType::
                DT_BFLOAT16;


    // ------------------------------------------------------------------------
    // Matmul tiling
    // ------------------------------------------------------------------------

    matmul_tiling::
        MatmulApiTiling
            tiler(*platform);


    CheckTiling(
        tiler.SetAType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            inputType,

            transposeX1
        )
    );


    CheckTiling(
        tiler.SetBType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            inputType,

            transposeX2
        )
    );


    CheckTiling(
        tiler.SetCType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            matmul_tiling::
                DataType::
                    DT_FLOAT
        )
    );


    CheckTiling(
        tiler.SetBias(
            false)
    );


    CheckTiling(
        tiler.SetOrgShape(
            shape.m,
            shape.n,
            shape.k)
    );


    CheckTiling(
        tiler.SetShape(

            std::min<uint32_t>(
                splitM,
                shape.m),

            shape.n,

            shape.k)
    );


    CheckTiling(
        tiler.SetBufferSpace(
            -1,
            -1,
            -1)
    );


    /*
     * (baseM, baseN, M 窗口) 的联合请求阶梯，全部由 SetFixSplit/GetTiling 的
     * **返回值**驱动，不猜、不校验后自杀：
     *   * 窗口从 MAX_WINDOW_BLOCKS 逐档退到 1（M 优先迭代顺序才允许 >1，见下）；
     *   * baseM 档：先 splitM（= min(MAX_BASE_M, ceil16(m))），最后退回基线用的 16；
     *   * baseN 档：从 splitN 一路退到 8；
     *   * 最后那一档 = 基线（真机 15/15）的 (16, splitN)，一定拿得到 tiling。
     *
     * 窗口为什么要跟迭代顺序绑定：kernel 侧按 `mBlk = tileIdx % mBlocks` 把分片
     * 路由到各行块的归并区，而这个解码只在"先 M 轴再 N 轴"成立（`Iterate.md:21`
     * 说这是默认顺序，`TCubeTiling` 记 iterateOrder=0）。一旦 tiler 给出别的顺序，
     * 只接受窗口为 1 的档（退化回单行块，解码无歧义）。
     */
    CubeTiling tiling;

    /*
     * baseN 的请求顺序：
     *   第一档 = splitN 本身（就是基线用的那个 baseN 口径，保证"基线能出的 tiling 我们也能出"）；
     *   然后方阵优先带 128 → 64 → 32 → 16 → 8（baseM≈baseN，L0C 留出 dbL0C=2）；
     *   最后才是大 baseN 兜底带 256 → 192 → 160 → 96（只有 tiler 对某些 shape 只肯给
     *   更大的 baseN 时才用得上；那时分片是 128×baseN，dbL0C=1，是"能用"而不是"最优"）。
     */
    static const int32_t BASE_N_LADDER[] = {
        128, 64, 32, 16, 8,
        256, 192, 160, 96
    };

    static const uint32_t BASE_N_LADDER_COUNT =
        static_cast<uint32_t>(
            sizeof(BASE_N_LADDER) /
            sizeof(BASE_N_LADDER[0]));


    int32_t chosenM = 0;
    int32_t chosenN = 0;

    for (uint32_t stage = 0;
         stage < 2U && chosenN == 0;
         ++stage) {

        /* stage 0 = 方阵档；stage 1 = 基线（真机 15/15）用的 (16, splitN) 兜底档 */
        const uint32_t singleMBase =
            (stage == 0U)
                ? splitM
                : 16U;

        tiler.SetShape(

            std::min<uint32_t>(
                singleMBase,
                shape.m),

            shape.n,

            shape.k);

        const int32_t baseMRequest =
            static_cast<int32_t>(
                singleMBase);

        {

            for (uint32_t slot = 0;
                 slot <= BASE_N_LADDER_COUNT;
                 ++slot) {

                const int32_t request =
                    (
                        slot == 0U
                    )
                        ? static_cast<int32_t>(
                              splitN)
                        : BASE_N_LADDER[
                              slot -
                              1U];

                /* 只允许 baseN <= splitN（= ceil8(singleN) 口径）且不小于 8，并去重 */
                if (
                    request < 8 ||
                    request >
                        static_cast<int32_t>(
                            splitN) ||
                    (
                        slot > 0U &&
                        request ==
                            static_cast<int32_t>(
                                splitN)
                    )
                ) {

                    continue;
                }

                if (
                    tiler.SetFixSplit(
                        baseMRequest,
                        request,
                        -1) != 0
                ) {

                    continue;
                }

                if (
                    tiler.GetTiling(
                        tiling) != 0
                ) {

                    continue;
                }

                chosenM = baseMRequest;
                chosenN = request;

                break;
            }
        }
    }


    if (chosenN == 0) {

        Fail();
    }


    /*
     * 用最终选定的配置**重算一次**，保证拿到的 tiling 来自一次干净的
     * setter -> getter（与基线完全同构），而不是多次试探后的残留状态。
     */
    CheckTiling(
        tiler.SetShape(

            std::min<uint32_t>(
                static_cast<uint32_t>(
                    chosenM),
                shape.m),

            shape.n,

            shape.k)
    );


    CheckTiling(
        tiler.SetFixSplit(
            chosenM,
            chosenN,
            -1)
    );


    CheckTiling(
        tiler.GetTiling(
            tiling)
    );


    /*
     * 回读校验 —— 只保留 kernel 侧**真的会**依赖的必要条件：
     *   * 上界：UB 缓冲与 GM 槽位都按 MAX_* 分配，回读值不得超；
     *   * baseN 8 对齐：WholeReduceMax 的行距按 datablock(32B) 计。
     * 刻意**不再**要求 baseM >= min(splitM, m)：kernel 的行块步长就是 baseM，
     * validM = min(baseM, m - rowStart) 恒 <= baseM ⇒ mBlocks 恒为 1，
     * 与请求了多少无关。多挂这一条只会把"tiler 自己收敛到更小分片"这种
     * **完全合法**的情况变成 abort —— 而 abort 会被平台 ReplayOnce 重放，
     * 直接违反 "each iteration must launch exactly 1 kernel"（真机实测：
     * 7 个 case 各重放一次就把 75 抬成 110）。
     */
    if (
        tiling.baseM <= 0 ||
        tiling.baseN <= 0 ||
        static_cast<uint32_t>(
            tiling.baseM) > MAX_BASE_M ||
        static_cast<uint32_t>(
            tiling.baseN) > MAX_TILE_N ||
        (
            static_cast<uint32_t>(
                tiling.baseN) &
            7U) != 0U
    ) {

        Fail();
    }


    // ------------------------------------------------------------------------
    // Workspace
    // ------------------------------------------------------------------------

    const size_t systemBytes =

        std::max<size_t>(

            32,

            static_cast<size_t>(

                platform
                    ->GetLibApiWorkSpaceSize()
            )
        );


    void *systemDevice =
        nullptr;


    CheckAcl(
        aclrtMalloc(

            &systemDevice,

            systemBytes,

            ACL_MEM_MALLOC_HUGE_FIRST)
    );


    CheckAcl(
        aclrtMemset(

            systemDevice,

            systemBytes,

            0,

            systemBytes)
    );


    /*
     * staging：每 worker 一块，元素数 = baseM * (n + baseN)（多留一个分片的余量，
     * 与 kernel 侧的 cStage 公式逐字一致）。
     *
     * 两条必须做对的事：
     *   1. **总占用按预算收缩 blocks**：槽位数 = min(b, 2*blocks)，大 case（n 大、b 大）
     *      下按 blocks 全额申请会要到几百 MB —— 真机上 aclrtMalloc 失败就会走
     *      CheckAcl → abort（status 134），这正是"某个大 case 直接 RE"的典型成因。
     *   2. **malloc 失败继续退让**：再砍 blocks（并行度换内存），只留到 1 块还失败才 Fail。
     */
    static constexpr size_t
        STAGE_BUDGET =
            64ull << 20;


    /* slot 网格：ceil(n/baseN) + 1 个 slot，每 slot baseM*baseN 个元素（= kernel 侧公式） */
    const size_t stageElems =

        (
            (
                static_cast<size_t>(
                    shape.n) +
                static_cast<size_t>(
                    tiling.baseN) -
                1U
            ) /
            static_cast<size_t>(
                tiling.baseN) +
            1U
        ) *
        static_cast<size_t>(
            tiling.baseM) *
        static_cast<size_t>(
            tiling.baseN);


    const size_t perSlotBytes =
        stageElems *
        sizeof(float);


    /* 原子槽位区：每 batch 8 个 float = 32B（与 kernel 侧 out 的公式逐字一致） */
    const size_t atomBytes =
        static_cast<size_t>(
            shape.b) *
        8U *
        sizeof(float);


    while (
        blocks > 1U &&
        std::min<size_t>(
            static_cast<size_t>(
                shape.b),

            static_cast<size_t>(
                2U *
                blocks)) *
                perSlotBytes >
            STAGE_BUDGET
    ) {

        --blocks;
    }


    size_t cBytes =
        std::min<size_t>(

            static_cast<size_t>(
                shape.b),

            static_cast<size_t>(
                2U *
                blocks)) *
        perSlotBytes +
        atomBytes;


    void *cDevice =
        nullptr;


    while (
        aclrtMalloc(

            &cDevice,

            cBytes,

            ACL_MEM_MALLOC_HUGE_FIRST) !=
        ACL_SUCCESS
    ) {

        if (
            blocks <= 1U
        ) {

            Fail();
        }


        /* 内存不够就砍并行度再来（每块 staging 是刚需，只能少开 worker） */
        --blocks;

        cBytes =
            std::min<size_t>(

                static_cast<size_t>(
                    shape.b),

                static_cast<size_t>(
                    2U *
                    blocks)) *
            perSlotBytes +
            atomBytes;
    }


    /*
     * 原子加的初值必须是 0（SetAtomicAdd 不会清零；`SetAtomicAdd.md:47`），
     * 而且只清**原子槽位区**——y 由后面的纯搬运覆盖，不需要清。
     */
    CheckAcl(
        aclrtMemset(

            reinterpret_cast<char *>(
                cDevice) +
                cBytes -
                atomBytes,

            atomBytes,

            0,

            atomBytes)
    );


    // ------------------------------------------------------------------------
    // Cube + Vector MaxSim + Sum fused in one launch
    // ------------------------------------------------------------------------

    if (
        inputDtype == 1
    ) {

        LaunchMatmulPath<half>(

            x1,

            x2,

            y,

            (GM_ADDR)systemDevice,

            (GM_ADDR)cDevice,

            tiling,

            shape,

            blocks,

            stream,

            transposeX1,

            transposeX2
        );
    }

    else {

        LaunchMatmulPath<
            bfloat16_t>(

            x1,

            x2,

            y,

            (GM_ADDR)systemDevice,

            (GM_ADDR)cDevice,

            tiling,

            shape,

            blocks,

            stream,

            transposeX1,

            transposeX2
        );
    }


    /*
     * workspace 在本函数内部申请，
     * 所以释放前必须确保该 stream
     * 已经完成访问。
     *
     * 超时给足 60s：这个 timeout 只是"本地安全网"，判题有自己的 TLE。
     * 3s（基线值）在本版偏紧 —— 一旦真的超时，CheckAcl 会 Fail ⇒ abort
     * ⇒ 平台 ReplayOnce 重放 ⇒ **多出一次 kernel launch**，直接把
     * "each iteration must launch exactly 1 kernel" 顶破（真机实测 75 → 110）。
     * 宁可在这里等，也不要 abort。
     */
    CheckAcl(
        aclrtSynchronizeStreamWithTimeout(
            stream,
            60000)
    );


    /*
     * 纯搬运（不做算术）：把每 batch 那个 32B 原子槽的第 0 个 float 拷进 y。
     * 行块和本身是 AIV 上算出来的，这里只换地址 —— 核心计算仍然全在 NPU 上。
     */
    for (uint32_t batch = 0;
         batch < shape.b;
         ++batch) {

        CheckAcl(
            aclrtMemcpy(

                reinterpret_cast<char *>(y) +
                    static_cast<size_t>(batch) *
                        sizeof(float),

                sizeof(float),

                reinterpret_cast<char *>(cDevice) +
                    cBytes -
                    atomBytes +
                    static_cast<size_t>(batch) *
                        8U *
                        sizeof(float),

                sizeof(float),

                ACL_MEMCPY_DEVICE_TO_DEVICE)
        );
    }


    CheckAcl(
        aclrtFree(
            cDevice)
    );


    CheckAcl(
        aclrtFree(
            systemDevice)
    );
}

} // namespace bmmms


// ============================================================================
// Contest ABI
// ============================================================================

extern "C" void run_kernel(
    GM_ADDR x1,
    const TensorGroupInfo &info_x1,

    GM_ADDR x2,
    const TensorGroupInfo &info_x2,

    GM_ADDR y,
    const TensorGroupInfo &info_y,

    int64_t availableCoreNum,

    aclrtStream stream,

    bool transposeX1,

    bool transposeX2)
{
    bmmms::Launch(

        x1,
        info_x1,

        x2,
        info_x2,

        y,
        info_y,

        availableCoreNum,

        stream,

        transposeX1,

        transposeX2
    );
}


// ============================================================================
// VERIFY —— 上板必查（本机无 CANN / NPU；下面标 [真机] 的是队友在 910C 上探明的）
//
// 0) 【本版结构】task = (batch, 行块)，粒度按核数选：task 数 = b*ceil(m/baseM)，
//    host 把 blocks 夹到 ≤ 这个数（所以 b=1、m=4096 时是 32 个 task 而不是 1 个）。
//    每个 task 独占**整行**（N 不切）⇒ 行内不需要跨 task 归并；唯一的跨 task 合并是
//    "行块和 → y[batch]"，走**32B 对齐的原子加**（SetAtomicAdd<float>，槽内
//    [和,0,0,0,0,0,0,0]，那 7 个 0 不改变结果）。host 在 kernel 前置 0 这块、
//    kernel 之后用 aclrtMemcpy **纯搬运**把每 batch 的第 0 个 float 写进 y
//    （算术全在 NPU 上，host 只换地址）。
//    ⚠ 依赖：host 传的 workerCount = 2*blocks 必须等于**实际** AIV 数（不然有 task
//    永远没人领，结果偏小）。基线也是这个假设，真机 15/15 成立；上板若见"结果偏小"
//    且日志里 Mix Block Dim ≠ 2*Block Dim，就是这条。
//
// 1) 【判题硬规则】一次迭代只能启动 1 个 kernel；**任何 abort（host Fail() → status 134）
//    都会被平台 <ReplayOnce> 重放，每次重放多算一次 launch**（真机原文：
//    Expected 75, got 110 = 75 + 7×5）。本版保留的防线：
//      分片阶梯末档 = 基线精确配置（一定能出 tiling）、回读校验只留必要上界、
//      内部同步超时 60s、非活动 worker 的槽位夹到 0、staging 按预算收缩 + malloc 失败退让。
//    本地门禁：`python tools/launch_check.py kernel.asc`。
// 2) [真机] `IterateAll` 的条带布局：**slot 步进 = baseM*baseN**（不是 validM*baseN），
//    slot 内**行距 = 该 tile 自己的 validN**，只写有效行。本版据此读回；
//    若上板出现"只有 m%baseM!=0 的 case 错"，说明这台机器上步进口径不同，
//    改 kernel 里 `t*baseM*baseN`（读偏移）与 host 的 stageElems 公式即可。
// 3) [真机] **singleM < baseM 会多出 ghost tile** ⇒ M 尾块必须走逐 tile 的
//    Iterate/GetTensorC（本版已按 stripAtOnce 分支处理）。若上板 M 尾块错乱，
//    先确认这条分支真的生效（打印 validM/baseM）。
// 4) [真机] 归约用逐行 `ReduceMax(..., count=validN, false)` + N 尾片标量逐行读
//    —— 这是真机 15/15 基线验证过的路径，本版照搬（不再用两级 WholeReduceMax）。
// 5) [真机] 瓶颈是**单核 MTE2 流式带宽 ~38GB/s/core**，不是 HBM 总量、不是 K 步延迟。
//    所以"少穿 GM"的收益远大于"少发向量指令"；下一步若还要提速，方向是
//    IterateAll 直写 UB / async IterateAll + WaitIterateAll，而不是继续压指令数。
// 6) tiler 回读：host 只 Fail 必要条件（baseM ≤ 128、baseN ≤ 256、baseN % 8 == 0）。
//    期望 baseM=128/baseN=256（真机 sweep 出的最优档；baseN 会决定 tiler 选的 baseK）。
// 7) UB 预算：cUb(128×256×4 = 128KB) + reduceWork(1KB) + 3×512B ≈ 134KB / 192KB。
// 8) GM 预算：staging = min(b,2*blocks) × (ceil(n/baseN)+1) × baseM*baseN × 4B，
//    总占用按 64MB 预算收缩 blocks，malloc 失败继续砍 blocks 重试。
// 9) 确定性：片间只做 Max；唯一不确定的是跨 task 的原子加顺序（末位级）、无浮点累加顺序问题 ⇒ 结果应逐位可复现。
// 10) 精度：数值路径与基线一致（先跨 N 取 max，再按行升序求和）。
// ============================================================================
