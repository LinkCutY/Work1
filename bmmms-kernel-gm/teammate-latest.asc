#include <cstdint>
#include <cstdlib>
#include <algorithm>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"

namespace bmmms {

using namespace AscendC;
using CubeTiling = AscendC::tiling::TCubeTiling;

static constexpr uint32_t TILE_M = 16;
static constexpr uint32_t MAX_TILE_N = 256;
static constexpr uint64_t SMALL_MAC_LIMIT = 32768;

struct Shape {
    uint32_t b;
    uint32_t m;
    uint32_t n;
    uint32_t k;
};


// ============================================================================
// Device helpers
// ============================================================================

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

__aicore__ inline float AbsF32(float x)
{
    return x < 0.0f ? -x : x;
}

__aicore__ inline float Decode(half x)
{
    return static_cast<float>(x);
}

__aicore__ inline float Decode(bfloat16_t x)
{
    return AscendC::ToFloat(x);
}

__aicore__ inline void AddCompensated(
    float value,
    float &sum,
    float &correction)
{
    const float next = sum + value;

    if (AbsF32(sum) >= AbsF32(value)) {
        correction += (sum - next) + value;
    } else {
        correction += (value - next) + sum;
    }

    sum = next;
}

template <HardEvent E>
__aicore__ inline void Fence(TPipe &pipe)
{
    const event_t event =
        static_cast<event_t>(
            pipe.FetchEventID(E));

    SetFlag<E>(event);
    WaitFlag<E>(event);
}


// ============================================================================
// Small-input path
// ============================================================================

template <typename InputT>
__global__ __aicore__ void SmallKernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    Shape shape,
    bool transposeX1,
    bool transposeX2)
{
    if (GetBlockIdx() != 0) {
        return;
    }

    TPipe pipe;

    TBuf<TPosition::VECCALC> outBuf;

    pipe.InitBuffer(
        outBuf,
        64 * sizeof(float));

    LocalTensor<float> outLocal =
        outBuf.Get<float>();


    GlobalTensor<InputT> a;
    GlobalTensor<InputT> b;
    GlobalTensor<float> out;


    a.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x1),
        static_cast<uint64_t>(shape.b) *
            shape.m *
            shape.k);


    b.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x2),
        static_cast<uint64_t>(shape.b) *
            shape.n *
            shape.k);


    out.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(y),
        shape.b);


    for (uint32_t batch = 0;
         batch < shape.b;
         ++batch) {

        const uint64_t aBase =
            static_cast<uint64_t>(batch) *
            shape.m *
            shape.k;


        const uint64_t bBase =
            static_cast<uint64_t>(batch) *
            shape.n *
            shape.k;


        float total = 0.0f;
        float totalCorr = 0.0f;


        for (uint32_t row = 0;
             row < shape.m;
             ++row) {

            float best = 0.0f;


            for (uint32_t col = 0;
                 col < shape.n;
                 ++col) {

                float dot = 0.0f;
                float dotCorr = 0.0f;


                for (uint32_t kk = 0;
                     kk < shape.k;
                     ++kk) {

                    const uint64_t aOffset =
                        aBase +
                        (
                            transposeX1
                                ?
                                static_cast<uint64_t>(kk) *
                                        shape.m +
                                    row
                                :
                                static_cast<uint64_t>(row) *
                                        shape.k +
                                    kk
                        );


                    const uint64_t bOffset =
                        bBase +
                        (
                            transposeX2
                                ?
                                static_cast<uint64_t>(col) *
                                        shape.k +
                                    kk
                                :
                                static_cast<uint64_t>(kk) *
                                        shape.n +
                                    col
                        );


                    const float product =
                        Decode(
                            a.GetValue(aOffset)
                        )
                        *
                        Decode(
                            b.GetValue(bOffset)
                        );


                    AddCompensated(
                        product,
                        dot,
                        dotCorr);
                }


                const float score =
                    dot + dotCorr;


                if (col == 0 ||
                    score > best) {

                    best = score;
                }
            }


            AddCompensated(
                best,
                total,
                totalCorr);
        }


        outLocal.SetValue(
            batch,
            total + totalCorr);
    }


    Fence<HardEvent::S_MTE3>(
        pipe);


    DataCopyExtParams copyOut;

    copyOut.blockCount = 1;

    copyOut.blockLen =
        shape.b *
        sizeof(float);

    copyOut.srcStride = 0;
    copyOut.dstStride = 0;
    copyOut.rsv = 0;


    DataCopyPad(
        out,
        outLocal,
        copyOut);


    Fence<HardEvent::MTE3_S>(
        pipe);


    PipeBarrier<PIPE_ALL>();
}


// ============================================================================
// Cube Matmul + Vector MaxSim
// ============================================================================

template <
    typename InputT,
    bool TRANSPOSE_A,
    bool TRANSPOSE_B>
__global__ __aicore__ void MatmulMaxKernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    __kfc_workspace__ GM_ADDR systemWorkspace,
    GM_ADDR cWorkspace,
    CubeTiling tiling,
    Shape shape,
    uint32_t workerCount)
{
    TPipe pipe;


    using AType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            InputT,
            TRANSPOSE_A>;


    using BType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            InputT,
            TRANSPOSE_B>;


    using CType =
        MatmulType<
            TPosition::GM,
            CubeFormat::ND,
            float>;


    Matmul<
        AType,
        BType,
        CType> mm;


    REGIST_MATMUL_OBJ(
        &pipe,
        GetSysWorkSpacePtr(),
        mm,
        &tiling);


    TBuf<TPosition::VECCALC>
        cTileBuf;


    TBuf<TPosition::VECCALC>
        reduceWorkBuf;


    TBuf<TPosition::VECCALC>
        tileMaxBuf;


    TBuf<TPosition::VECCALC>
        bestBuf;


    TBuf<TPosition::VECCALC>
        rowOutBuf;


    pipe.InitBuffer(
        cTileBuf,
        TILE_M *
            MAX_TILE_N *
            sizeof(float));


    pipe.InitBuffer(
        reduceWorkBuf,
        MAX_TILE_N *
            sizeof(float));


    pipe.InitBuffer(
        tileMaxBuf,
        TILE_M *
            sizeof(float));


    pipe.InitBuffer(
        bestBuf,
        TILE_M *
            sizeof(float));


    pipe.InitBuffer(
        rowOutBuf,
        TILE_M *
            sizeof(float));


    LocalTensor<float>
        cUb =
            cTileBuf.Get<float>();


    LocalTensor<float>
        reduceWork =
            reduceWorkBuf.Get<float>();


    LocalTensor<float>
        tileMaxVec =
            tileMaxBuf.Get<float>();


    LocalTensor<float>
        bestVec =
            bestBuf.Get<float>();


    LocalTensor<float>
        rowOut =
            rowOutBuf.Get<float>();


    const uint32_t
        rowTilesPerBatch =
            (
                shape.m +
                TILE_M - 1
            ) /
            TILE_M;


    const uint32_t
        totalRowTiles =
            shape.b *
            rowTilesPerBatch;


    GlobalTensor<InputT> a;
    GlobalTensor<InputT> b;
    GlobalTensor<float> out;


    a.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x1),

        static_cast<uint64_t>(
            shape.b) *
            shape.m *
            shape.k);


    b.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ InputT *>(x2),

        static_cast<uint64_t>(
            shape.b) *
            shape.n *
            shape.k);


    out.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(y),

        static_cast<uint64_t>(
            shape.b));


    const uint32_t worker =
        static_cast<uint32_t>(
            GetBlockIdx());


    /*
     * AIV-side GetBlockNum() reports the AI Core
     * group count, not the flattened AIV worker
     * space that GetBlockIdx() enumerates. The
     * host passes 2 * blocks explicitly so every
     * task is claimed by exactly one AIV.
     */
    const uint32_t workers =
        workerCount;


    /*
     * Per-execution-unit GM scratch tile for the
     * packed baseM x baseN ND result written by
     * GetTensorC. AIV ids already span [0, 2N);
     * AIC group ids are shifted past that range
     * so a stray AIC-side fetch can never alias
     * an AIV slot.
     */
    uint32_t cSlot =
        worker;

    if
        ASCEND_IS_AIV
    {
        cSlot = worker;
    } else {
        cSlot =
            workers +
            worker;
    }


    GlobalTensor<float> cTile;

    cTile.SetGlobalBuffer(
        reinterpret_cast<
            __gm__ float *>(cWorkspace) +
            static_cast<uint64_t>(cSlot) *
                (TILE_M *
                    MAX_TILE_N),

        TILE_M *
            MAX_TILE_N);


    const uint32_t baseM =
        tiling.baseM;


    const uint32_t baseN =
        tiling.baseN;


    /*
     * One task per batch: the owning AIV walks
     * every row tile of its batch, accumulates
     * the row-max sums locally, and performs a
     * single plain write. No atomics, no
     * cross-worker accumulation.
     */
    for (uint32_t task = worker;
         task < shape.b;
         task += workers) {

        const uint32_t batch =
            task;


        float batchSum = 0.0f;


        for (uint32_t rowStart = 0;
             rowStart < shape.m;
             rowStart += TILE_M) {

        const uint32_t validM =
            MinU32(
                TILE_M,
                shape.m -
                    rowStart);


        const uint64_t aOffset =
            static_cast<uint64_t>(
                batch) *
                shape.m *
                shape.k
            +
            (
                TRANSPOSE_A
                    ?
                    static_cast<uint64_t>(
                        rowStart)
                    :
                    static_cast<uint64_t>(
                        rowStart) *
                        shape.k
            );


        const uint64_t bOffset =
            static_cast<uint64_t>(
                batch) *
            shape.n *
            shape.k;


        Duplicate(
            bestVec,
            -3.402823466e38f,
            TILE_M);


        mm.SetOrgShape(
            shape.m,
            shape.n,
            shape.k);


        mm.SetSingleShape(
            validM,
            shape.n,
            shape.k);


        mm.SetTensorA(
            a[aOffset],
            TRANSPOSE_A);


        mm.SetTensorB(
            b[bOffset],
            TRANSPOSE_B);


        const uint32_t mBlocks =
            (
                validM +
                baseM -
                1U
            ) /
            baseM;


        uint32_t tileIdx = 0;


        while (mm.Iterate()) {

            mm.GetTensorC(
                cTile,
                0,
                true);


            DataCopyExtParams
                copyParams;

            copyParams.blockCount = 1;

            copyParams.blockLen =
                baseM *
                baseN *
                sizeof(float);

            copyParams.srcStride = 0;
            copyParams.dstStride = 0;
            copyParams.rsv = 0;


            DataCopyPadExtParams<float>
                padParams;


            DataCopyPad(
                cUb,
                cTile,
                copyParams,
                padParams);


            Fence<
                HardEvent::MTE2_V>(
                    pipe);


            /*
             * Iterate emits baseM x baseN tiles in
             * M-inner / N-outer order; decode the
             * tile's logical position instead of
             * assuming the requested split.
             */
            const uint32_t mBlk =
                tileIdx %
                mBlocks;


            const uint32_t nBlk =
                tileIdx /
                mBlocks;


            const uint32_t rowBase =
                mBlk *
                baseM;


            const uint32_t rows =
                MinU32(
                    baseM,
                    validM -
                        rowBase);


            const uint32_t columnStart =
                nBlk *
                baseN;


            const uint32_t validN =
                MinU32(
                    baseN,
                    shape.n -
                        columnStart);


            Duplicate(
                tileMaxVec,
                -3.402823466e38f,
                TILE_M);


            if (validN == baseN) {

            for (uint32_t row = 0;
                 row < rows;
                 ++row) {

                ReduceMax(
                    tileMaxVec[
                        rowBase +
                        row
                    ],
                    cUb[
                        row *
                        baseN
                    ],
                    reduceWork,
                    static_cast<int32_t>(
                        validN),
                    false);
            }

            } else {

            /*
             * Tail-N tile: KFC sequential write is
             * packed at the valid width, so rows sit
             * at row * validN. Vector reads need 32B
             * alignment; use scalar loads instead.
             */
            for (uint32_t row = 0;
                 row < rows;
                 ++row) {

                float rowBest =
                    -3.402823466e38f;

                const uint32_t srcBase =
                    row * validN;

                for (uint32_t col = 0;
                     col < validN;
                     ++col) {

                    const float v =
                        cUb.GetValue(
                            srcBase + col);

                    if (v > rowBest) {
                        rowBest = v;
                    }
                }


                tileMaxVec.SetValue(
                    rowBase + row,
                    rowBest);
            }

            }


            Max(
                bestVec,
                bestVec,
                tileMaxVec,
                TILE_M);


            ++tileIdx;
        }


        Fence<
            HardEvent::V_S>(
                pipe);


        float tileSum = 0.0f;


        for (uint32_t row = 0;
             row < validM;
             ++row) {

            tileSum +=
                bestVec
                    .GetValue(row);
        }


        batchSum += tileSum;


        Fence<
            HardEvent::S_V>(
                pipe);
        }


        if
            ASCEND_IS_AIV
        {

            rowOut.SetValue(
                0,
                batchSum);


            Fence<
                HardEvent::S_MTE3>(
                    pipe);


            DataCopyExtParams
                copyOut;

            copyOut.blockCount = 1;

            copyOut.blockLen =
                sizeof(float);

            copyOut.srcStride = 0;
            copyOut.dstStride = 0;
            copyOut.rsv = 0;


            DataCopyPad(
                out[
                    batch
                ],
                rowOut,
                copyOut);


            Fence<
                HardEvent::MTE3_S>(
                    pipe);
        }
    }


    mm.End();


    PipeBarrier<PIPE_ALL>();
}


// ============================================================================
// Host helpers
// ============================================================================

[[noreturn]]
inline void Fail()
{
    std::abort();
}


inline void CheckAcl(
    aclError result)
{
    if (result !=
        ACL_SUCCESS) {

        std::abort();
    }
}


inline void CheckTiling(
    int64_t result)
{
    if (result < 0) {
        std::abort();
    }
}


inline const TensorInfo &
SingleTensor(
    const TensorGroupInfo &info)
{
    if (
        info.numTensors != 1 ||
        info.tensors == nullptr ||
        info.tensors[0].shape ==
            nullptr
    ) {

        Fail();
    }


    return
        info.tensors[0];
}


// ============================================================================
// Metadata parsing
// ============================================================================

inline Shape ParseShape(
    const TensorGroupInfo &infoX1,
    const TensorGroupInfo &infoX2,
    const TensorGroupInfo &infoY,
    bool transposeX1,
    bool transposeX2)
{
    const TensorInfo &a =
        SingleTensor(infoX1);


    const TensorInfo &b =
        SingleTensor(infoX2);


    const TensorInfo &out =
        SingleTensor(infoY);


    if (
        a.numDims != 3 ||
        b.numDims != 3 ||
        out.numDims != 1
    ) {
        Fail();
    }


    if (
        a.dtype != b.dtype ||
        (
            a.dtype != 1 &&
            a.dtype != 2
        ) ||
        out.dtype != 0
    ) {
        Fail();
    }


    const int64_t B =
        a.shape[0];


    const int64_t M =
        a.shape[
            transposeX1
                ? 2
                : 1
        ];


    const int64_t K1 =
        a.shape[
            transposeX1
                ? 1
                : 2
        ];


    const int64_t K2 =
        b.shape[
            transposeX2
                ? 2
                : 1
        ];


    const int64_t N =
        b.shape[
            transposeX2
                ? 1
                : 2
        ];


    if (
        B <= 0 ||
        M <= 0 ||
        N <= 0 ||
        K1 <= 0 ||
        K2 <= 0 ||
        b.shape[0] != B ||
        K1 != K2 ||
        out.shape[0] != B
    ) {

        Fail();
    }


    Shape shape;


    shape.b =
        static_cast<uint32_t>(
            B);


    shape.m =
        static_cast<uint32_t>(
            M);


    shape.n =
        static_cast<uint32_t>(
            N);


    shape.k =
        static_cast<uint32_t>(
            K1);


    return shape;
}


// ============================================================================
// Four storage layouts
// ============================================================================

template <typename InputT>
inline void LaunchMatmulPath(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR y,
    GM_ADDR workspace,
    GM_ADDR cWorkspace,
    const CubeTiling &tiling,
    Shape shape,
    uint32_t blocks,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    if (
        !transposeX1 &&
        !transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            false,
            false>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else if (
        !transposeX1 &&
        transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            false,
            true>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else if (
        transposeX1 &&
        !transposeX2
    ) {

        MatmulMaxKernel<
            InputT,
            true,
            false>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }

    else {

        MatmulMaxKernel<
            InputT,
            true,
            true>
            <<<blocks,
               nullptr,
               stream>>>(
                x1,
                x2,
                y,
                workspace,
                cWorkspace,
                tiling,
                shape,
                2U * blocks);
    }
}


// ============================================================================
// Launch
// ============================================================================

inline void Launch(
    GM_ADDR x1,
    const TensorGroupInfo &infoX1,
    GM_ADDR x2,
    const TensorGroupInfo &infoX2,
    GM_ADDR y,
    const TensorGroupInfo &infoY,
    int64_t availableCoreNum,
    aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    const Shape shape =
        ParseShape(
            infoX1,
            infoX2,
            infoY,
            transposeX1,
            transposeX2);


    const int32_t inputDtype =
        infoX1
            .tensors[0]
            .dtype;


    const uint64_t macs =
        static_cast<uint64_t>(
            shape.b)
        *
        shape.m
        *
        shape.n
        *
        shape.k;


    // ------------------------------------------------------------------------
    // Tiny shape path
    // ------------------------------------------------------------------------

    if (
        macs <=
        SMALL_MAC_LIMIT
    ) {

        if (
            inputDtype == 1
        ) {

            SmallKernel<half>
                <<<1,
                   nullptr,
                   stream>>>(
                    x1,
                    x2,
                    y,
                    shape,
                    transposeX1,
                    transposeX2);
        }

        else {

            SmallKernel<bfloat16_t>
                <<<1,
                   nullptr,
                   stream>>>(
                    x1,
                    x2,
                    y,
                    shape,
                    transposeX1,
                    transposeX2);
        }


        return;
    }


    // ------------------------------------------------------------------------
    // Matmul path
    // ------------------------------------------------------------------------

    if (
        availableCoreNum <= 0
    ) {

        Fail();
    }


    platform_ascendc::
        PlatformAscendC *platform =

        platform_ascendc::
            PlatformAscendCManager::
                GetInstance();


    if (
        platform ==
        nullptr
    ) {

        Fail();
    }


    const uint32_t
        rowTilesPerBatch =

        (
            shape.m +
            TILE_M - 1
        ) /
        TILE_M;


    const uint32_t
        totalRowTiles =

        shape.b *
        rowTilesPerBatch;


    const uint32_t
        hardwareCubeCores =

        platform
            ->GetCoreNumAic();


    if (
        hardwareCubeCores ==
        0
    ) {

        Fail();
    }


    uint32_t blocks =

        static_cast<uint32_t>(

            std::min<int64_t>(

                availableCoreNum,

                static_cast<int64_t>(
                    hardwareCubeCores)
            )
        );


    blocks =
        std::min<uint32_t>(
            blocks,
            totalRowTiles);


    if (
        blocks == 0
    ) {

        blocks = 1;
    }


    const uint32_t tileN =

        std::min<uint32_t>(

            MAX_TILE_N,

            (
                (
                    shape.n +
                    15U
                ) /
                16U
            )
            *
            16U
        );


    const
    matmul_tiling::DataType
        inputType =

        inputDtype == 1

        ?
        matmul_tiling::
            DataType::
                DT_FLOAT16

        :
        matmul_tiling::
            DataType::
                DT_BFLOAT16;


    // ------------------------------------------------------------------------
    // Matmul tiling
    // ------------------------------------------------------------------------

    matmul_tiling::
        MatmulApiTiling
            tiler(*platform);


    CheckTiling(
        tiler.SetAType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            inputType,

            transposeX1
        )
    );


    CheckTiling(
        tiler.SetBType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            inputType,

            transposeX2
        )
    );


    CheckTiling(
        tiler.SetCType(

            matmul_tiling::
                TPosition::GM,

            matmul_tiling::
                CubeFormat::ND,

            matmul_tiling::
                DataType::
                    DT_FLOAT
        )
    );


    CheckTiling(
        tiler.SetBias(
            false)
    );


    CheckTiling(
        tiler.SetOrgShape(
            shape.m,
            shape.n,
            shape.k)
    );


    CheckTiling(
        tiler.SetShape(

            std::min<uint32_t>(
                TILE_M,
                shape.m),

            shape.n,

            shape.k)
    );


    CheckTiling(
        tiler.SetFixSplit(
            TILE_M,
            tileN,
            -1)
    );


    CheckTiling(
        tiler.SetBufferSpace(
            -1,
            -1,
            -1)
    );


    CubeTiling tiling;


    CheckTiling(
        tiler.GetTiling(
            tiling)
    );


    // ------------------------------------------------------------------------
    // Workspace
    // ------------------------------------------------------------------------

    const size_t systemBytes =

        std::max<size_t>(

            32,

            static_cast<size_t>(

                platform
                    ->GetLibApiWorkSpaceSize()
            )
        );


    void *systemDevice =
        nullptr;


    CheckAcl(
        aclrtMalloc(

            &systemDevice,

            systemBytes,

            ACL_MEM_MALLOC_HUGE_FIRST)
    );


    CheckAcl(
        aclrtMemset(

            systemDevice,

            systemBytes,

            0,

            systemBytes)
    );


    CheckAcl(
        aclrtMemset(

            y,

            static_cast<size_t>(
                shape.b) *
                sizeof(float),

            0,

            static_cast<size_t>(
                shape.b) *
                sizeof(float))
    );


    /*
     * Per-execution-unit GM scratch for packed
     * baseM x baseN ND tiles written by
     * GetTensorC: 2 AIV slots per block plus a
     * shifted slot per AIC (3 * blocks total).
     */
    const size_t cBytes =

        static_cast<size_t>(
            blocks) *
        3U *
        TILE_M *
        MAX_TILE_N *
        sizeof(float);


    void *cDevice =
        nullptr;


    CheckAcl(
        aclrtMalloc(

            &cDevice,

            cBytes,

            ACL_MEM_MALLOC_HUGE_FIRST)
    );


    // ------------------------------------------------------------------------
    // Cube + Vector MaxSim + Sum fused in one launch
    // ------------------------------------------------------------------------

    if (
        inputDtype == 1
    ) {

        LaunchMatmulPath<half>(

            x1,

            x2,

            y,

            (GM_ADDR)systemDevice,

            (GM_ADDR)cDevice,

            tiling,

            shape,

            blocks,

            stream,

            transposeX1,

            transposeX2
        );
    }

    else {

        LaunchMatmulPath<
            bfloat16_t>(

            x1,

            x2,

            y,

            (GM_ADDR)systemDevice,

            (GM_ADDR)cDevice,

            tiling,

            shape,

            blocks,

            stream,

            transposeX1,

            transposeX2
        );
    }


    /*
     * workspace 在本函数内部申请，
     * 所以释放前必须确保该 stream
     * 已经完成访问。
     */
    CheckAcl(
        aclrtSynchronizeStreamWithTimeout(
            stream,
            3000)
    );


    CheckAcl(
        aclrtFree(
            cDevice)
    );


    CheckAcl(
        aclrtFree(
            systemDevice)
    );
}

} // namespace bmmms


// ============================================================================
// Contest ABI
// ============================================================================

extern "C" void run_kernel(
    GM_ADDR x1,
    const TensorGroupInfo &info_x1,

    GM_ADDR x2,
    const TensorGroupInfo &info_x2,

    GM_ADDR y,
    const TensorGroupInfo &info_y,

    int64_t availableCoreNum,

    aclrtStream stream,

    bool transposeX1,

    bool transposeX2)
{
    bmmms::Launch(

        x1,
        info_x1,

        x2,
        info_x2,

        y,
        info_y,

        availableCoreNum,

        stream,

        transposeX1,

        transposeX2
    );
}